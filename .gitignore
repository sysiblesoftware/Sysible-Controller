__pycache__/
*.pyc
venv/
.venv/

# Front-end build outputs — regenerated by `npm run build`; never commit. If they
# land in a deploy checkout they show as untracked and collide with a self-update
# ("untracked working tree files would be overwritten"), so keep them ignored.
webgui/frontend/node_modules/
webgui/frontend/dist/
*.db
# SQLite write-ahead-log / shared-memory / rollback sidecars (regenerated at runtime)
*.db-wal
*.db-shm
*.db-journal
api_key.txt
hosts.json
agent_state.json
agent_ssh_state.json
remote_keys/
certs/
logs/
portal_files/
.vscode/
.idea/
.DS_Store

# Runtime state (PID/port/secret) and logs - never commit
run/
logs/

# Documentation tooling - kept local, NOT published on GitHub.
# (The generated HTML guides at the repo root ARE committed, and the release
#  screenshots under docs/screenshots/ are now tracked so the README renders on
#  GitHub; only the doc generator/regenerate hook stays local.)
/tools/generate_docs.py
# Shared Claude Code config (settings.json + hooks) IS committed so the
# SessionStart hook applies to every session; only personal overrides are local.
/.claude/settings.local.json

# Python virtualenv (created by the SessionStart hook)
.venv/

# Local container env (generated by start-container.sh; holds the controller address)
.env
