#!/usr/bin/env bash
# sysible_ctl — one CLI to manage every Sysible product container.
#
# Products: controller (Sysible Controller), slep (Sysible Linux Engineering
# Platform), connect (Sysible Connect), slop (the SLOP gateway/portal — the single
# front door; its compose also bundles the Flashback config-time-machine module, so
# `slop up/status/logs` covers it — there is no separate flashback product). Each
# runs as a docker-compose service
# from its own checkout; this tool drives them all with a single, consistent set
# of commands so you don't have to remember per-product invocations or cd around.
#
#   sysible_ctl controller update      # update just the Controller
#   sysible_ctl slep logs              # follow SLEP's logs
#   sysible_ctl update all             # update every installed product
#   sysible_ctl status                 # overview of all products
#
# HOW IT FINDS EACH PRODUCT: from the running container's compose labels
# (config file + working dir), so it works no matter where each repo lives — no
# path guessing. If a product's container isn't running, point the tool at its
# checkout with SYSIBLE_<PRODUCT>_DIR (e.g. SYSIBLE_SLEP_DIR=/opt/sysible-slep).
#
# 'update' rebuilds the image FROM SOURCE (git pull the checkout, then
# 'compose up -d --build') and NEVER touches the named data volume, so the DB,
# certs, keys and files survive every update.
#
# Install once:  sudo ./deploy/sysible_ctl install   → then run `sysible_ctl …`
set -euo pipefail

# --- product registry ------------------------------------------------------
# Every known product id. Add one here + a case in each _p_* accessor to extend.
PRODUCTS="controller slep connect slop"

# For discovery we need ONE container of the product's compose stack.
_p_container() { case "$1" in
  controller)    echo "${SYSIBLE_CONTROLLER_CONTAINER:-sysible-controller}" ;;
  slep)          echo "${SYSIBLE_SLEP_CONTAINER:-sysible-slep}" ;;
  connect)       echo "${SYSIBLE_CONNECT_CONTAINER:-sysible-connect}" ;;
  slop)          echo "${SYSIBLE_SLOP_CONTAINER:-sysible-slop-gateway}" ;;
esac; }
_p_pretty() { case "$1" in
  controller)    echo "Sysible Controller" ;;
  slep)          echo "Sysible Linux Engineering Platform" ;;
  connect)       echo "Sysible Connect" ;;
  slop)          echo "Sysible SLOP gateway" ;;
esac; }
_p_port() { case "$1" in
  controller) echo 8800 ;;
  slep)       echo 8810 ;;
  connect)    echo 8700 ;;
  slop)       echo 443 ;;
esac; }
# Space-separated volume list (a product may keep state across several volumes).
_p_volume() { case "$1" in
  controller)    echo sysible-data ;;
  slep)          echo slep-data ;;
  connect)       echo connect-data ;;
  # The slop stack keeps the IdP user store, Caddy's certs/config, AND the Flashback
  # version store (Flashback is a service in the slop compose, not a separate stack).
  slop)          echo "slop-idp-data slop-caddy-data slop-caddy-config flashback-data" ;;
esac; }
_p_health_path() { case "$1" in
  controller|slep) echo /api/health ;;
  connect)         echo /healthz ;;
  slop)            echo / ;;   # the portal apex (Caddy serves the landing page)
esac; }
# True when the product is a multi-service compose stack (drive it via compose,
# not single docker-by-container commands). None in CE today.
_p_multi() { case "$1" in *) return 1 ;; esac; }
# Optional explicit checkout dir (used when the container isn't running).
_p_dir_override() { case "$1" in
  controller)    echo "${SYSIBLE_CONTROLLER_DIR:-}" ;;
  slep)          echo "${SYSIBLE_SLEP_DIR:-}" ;;
  connect)       echo "${SYSIBLE_CONNECT_DIR:-}" ;;
  slop)          echo "${SYSIBLE_SLOP_DIR:-}" ;;
esac; }

# Normalise product aliases → canonical id.
_canon() { case "$1" in ce|controller) echo controller ;; *) echo "$1" ;; esac; }
_is_product() { case " $PRODUCTS " in *" $(_canon "$1") "*) return 0 ;; *) return 1 ;; esac; }

# --- colours (only on a TTY) -----------------------------------------------
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; CYAN=$'\033[36m'; RESET=$'\033[0m'
else
  BOLD=''; RED=''; GREEN=''; YELLOW=''; CYAN=''; RESET=''
fi
_hdr()  { printf '%s\n' "${BOLD}${CYAN}==> $*${RESET}"; }
_ok()   { printf '%s\n' "${GREEN}$*${RESET}"; }
_warn() { printf '%s\n' "${YELLOW}$*${RESET}" >&2; }
_err()  { printf '%s\n' "${RED}ERROR: $*${RESET}" >&2; }
_die()  { _err "$@"; exit 1; }

# Resolve through symlinks to the REAL script in the checkout — `install` puts a
# `sysible_ctl` symlink on PATH, and first-run `up` must find the Controller
# repo (this script lives at <controller-checkout>/deploy/sysible_ctl).
_SRC="${BASH_SOURCE[0]}"
command -v readlink >/dev/null 2>&1 && _SRC="$(readlink -f "$_SRC" 2>/dev/null || echo "$_SRC")"
SELF="$(cd "$(dirname "$_SRC")" && pwd)/$(basename "$_SRC")"
# The Controller checkout that ships this script (…/deploy/sysible_ctl → repo root).
_CTL_REPO="$(cd "$(dirname "$SELF")/.." && pwd)"

_need_docker() {
  command -v docker >/dev/null 2>&1 || _die "docker is not installed or not on PATH. Install Docker Engine: https://docs.docker.com/engine/install/"
  docker info >/dev/null 2>&1 && return 0
  # Docker is installed but we can't reach the daemon. The usual cause is that the
  # invoking user isn't in the 'docker' group, so the root-owned socket is denied.
  # If so and we're not root, transparently re-run the whole command under sudo.
  local err; err="$(docker info 2>&1 >/dev/null || true)"
  case "$err" in
    *ermission\ denied*|*connect*docker.sock*|*dial\ unix*)
      if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
        _warn "No access to the Docker socket as '$(id -un)' — re-running with sudo."
        _warn "Skip sudo next time: sudo usermod -aG docker $(id -un)  then log out/in (or: newgrp docker)."
        exec sudo -- "$0" "${_ARGV[@]}"
      fi
      _die "No permission to access the Docker socket. Run with sudo, or add yourself to the docker group: sudo usermod -aG docker $(id -un)  then log out/in (or: newgrp docker)."
      ;;
    *)
      _die "the Docker daemon isn't reachable. Is it running?  Try: sudo systemctl start docker  (docker said: $err)"
      ;;
  esac
}

# --- compose plumbing ------------------------------------------------------
DC=()
_detect_compose() {
  if docker compose version >/dev/null 2>&1; then DC=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then DC=(docker-compose)
  else _die "neither 'docker compose' (v2 plugin) nor 'docker-compose' is available. Install the Compose plugin: https://docs.docker.com/compose/install/"; fi
}

# Discover the compose file + working dir for product $1. Prefers the running
# container's compose labels; falls back to SYSIBLE_<P>_DIR/docker-compose.yml.
# Sets globals CONTAINER, CFG, WD. Returns 1 if the product can't be driven.
CONTAINER=''; CFG=''; WD=''
_discover() {
  local p="$1"; CONTAINER="$(_p_container "$p")"; CFG=''; WD=''
  if docker inspect "$CONTAINER" >/dev/null 2>&1; then
    CFG="$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$CONTAINER" 2>/dev/null || true)"
    WD="$(docker inspect  -f '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}'  "$CONTAINER" 2>/dev/null || true)"
  fi
  if [[ -z "$CFG" ]]; then
    local d; d="$(_p_dir_override "$p")"
    for c in "$d/docker-compose.yml" "$d/deploy/docker-compose.yml"; do
      [[ -n "$d" && -f "$c" ]] && { WD="$(dirname "$c")"; CFG="$c"; break; }
    done
  fi
  [[ -n "$CFG" ]]
}

# Run a compose subcommand against the discovered file, from its working dir.
_compose() { _detect_compose; ( cd "${WD:-.}" 2>/dev/null || true; "${DC[@]}" -f "$CFG" "$@" ); }

# Echo the compose file under a checkout dir (root or deploy/), or fail. Used by
# first-run `up`, before any container/labels exist to discover from.
_compose_file_in() {
  local d="$1" c
  for c in "$d/docker-compose.yml" "$d/deploy/docker-compose.yml" "$d/deploy/docker/docker-compose.yml"; do
    [[ -f "$c" ]] && { echo "$c"; return 0; }
  done
  return 1
}

# Walk up from $1 to find the enclosing git checkout root, or fail.
_git_root() {
  local d="$1"
  while [[ -n "$d" && "$d" != "/" ]]; do [[ -d "$d/.git" ]] && { echo "$d"; return 0; }; d="$(dirname "$d")"; done
  return 1
}

# Does this product have something to act on (a container, or a configured dir)?
_present() {
  docker inspect "$(_p_container "$1")" >/dev/null 2>&1 && return 0
  [[ -n "$(_p_dir_override "$1")" ]]
}

# The HTTP status a product answers its health path with — or nothing at all.
#
# PROBE BY IP, NEVER BY NAME. The SLOP gateway has no domain: it mints ONE
# self-signed cert under a fixed internal name (the cert-holder site) and leans on
# `default_sni` to serve that cert for connections which send NO SNI — which is
# exactly what a browser hitting https://<server-ip>/ does. curl DOES send SNI for
# a hostname, so `https://localhost/` matches no certificate and Caddy aborts the
# handshake; `-k` cannot rescue that, because the failure is a TLS alert from the
# SERVER, not a validation error at the client. Probing localhost asked the gateway
# for the one thing it is built never to serve, so every `slop update` reported a
# perfectly healthy gateway as "NOT answering on port 443" — while the same gateway
# was visibly serving the operator's browser. curl sends no SNI for an IP literal,
# so 127.0.0.1 reproduces the browser's path exactly.
#
# -w '%{http_code}', not -f: -f collapses "nothing is listening" and "it answered,
# with a status I did not like" into one exit code, and those need different
# advice. curl prints 000 and exits non-zero when it never got an HTTP response.
_health_probe() {
  local p="$1" port path url code
  port="$(_p_port "$p")"; path="$(_p_health_path "$p")"
  for url in "https://127.0.0.1:${port}${path}" "http://127.0.0.1:${port}${path}"; do
    code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$url" 2>/dev/null || true)"
    if [[ -n "$code" && "$code" != "000" ]]; then printf '%s %s\n' "$code" "$url"; return 0; fi
  done
  return 1
}

# Does that status count as healthy for THIS product?
_health_verdict() {
  local p="$1" code="$2"
  # 3xx is the healthy answer for the gateway, not a near-miss: its apex sits
  # behind forward_auth, so an anonymous probe is redirected to /login.
  case "$code" in 2*|3*) return 0 ;; esac
  # The gateway is a REVERSE PROXY. A 4xx/5xx from it means the gateway itself is
  # up and something BEHIND it is not — calling that "the gateway is not answering"
  # sends the operator to fix the wrong box, which is the exact misdiagnosis this
  # whole check was added to prevent.
  [[ "$p" == "slop" ]] && return 0
  return 1
}

# Health probe for product $1. Quiet on failure: _health_wait polls this for up to
# a minute and does the reporting, so a line per attempt would bury the result.
_health() {
  local p="$1" out code url
  out="$(_health_probe "$p")" || return 1
  code="${out%% *}"; url="${out#* }"
  _health_verdict "$p" "$code" || return 1
  case "$code" in
    2*|3*) _ok "  health: OK  ($url -> $code)" ;;
    *)     _ok "  health: $(_p_pretty "$p") is answering ($url -> $code)"
           # The apex proxies to the portal/IdP, so a 5xx here is that service —
           # not one of the three fronted apps. Point at the command that says which.
           _warn "  $code comes from BEHIND the gateway (the portal/IdP), not the gateway itself."
           _warn "  For the fronted apps: $(basename "$0") slop status" ;;
  esac
  return 0
}

# Wait for a product to actually answer, then SAY SO — or say why it didn't.
#
# A single 5s probe right after `up -d --build` is a coin flip: the images were
# just rebuilt and the container may still be starting. The old code ran that one
# probe, discarded the result with `|| true`, and printed "is up." regardless — so
# "no response on 443" arrived as a shrug immediately followed by a success line,
# and there was nothing to act on. A bring-up that cannot serve its own port is a
# FAILED bring-up, and the container's last words are the diagnosis.
_health_wait() {
  local p="$1" secs="${2:-60}" i port c path
  port="$(_p_port "$p")"; c="$(_p_container "$p")"; path="$(_p_health_path "$p")"
  for ((i = 0; i < secs; i += 2)); do
    if _health "$p"; then return 0; fi
    sleep 2
  done
  # "Not answering" and "answering with a status I refuse" are different faults
  # and need different advice; saying the first when it was the second is how an
  # operator ends up restarting a service that was never the problem.
  local last; last="$(_health_probe "$p" || true)"
  if [[ -n "$last" ]]; then
    _err "$(_p_pretty "$p") answered ${last%% *} on port ${port} after ${secs}s — not a healthy status."
  else
    _err "$(_p_pretty "$p") is NOT answering on port ${port} after ${secs}s."
  fi
  # Name what was probed. "Not answering on 443" says nothing about WHAT was
  # asked, and the answer turned on exactly that: probing by hostname made the
  # gateway abort the TLS handshake, so a healthy gateway reported as dead and
  # the output gave no way to tell a stale copy of this script from a live fault.
  _warn "  probed: https://127.0.0.1:${port}${path}  then  http://127.0.0.1:${port}${path}"
  if docker inspect "$c" >/dev/null 2>&1; then
    docker ps -a --filter "name=^/${c}$" \
      --format '    {{.Names}}  {{.Status}}  {{.Ports}}' 2>/dev/null
    _warn "  last lines from '$c':"
    docker logs --tail 30 "$c" 2>&1 | sed 's/^/    /'
  else
    _err "  there is no container named '$c' — the stack did not start."
    _warn "  check the build output above, then: $(basename "$0") $p logs"
  fi
  return 1
}

# =========================================================
# Per-product operations
# =========================================================
# Carry SLOP-owned settings that OTHER products need into their compose .env.
#
# install.sh does this on a first run, and nothing did it afterwards — so a
# setting introduced by a later SLOP release never reached the app that consumes
# it, and `slop update` reported success having wired up nothing. That is exactly
# how config backup shipped inert: Flashback had its token, the Controller never
# got it, and the console stayed empty with no error anywhere.
#
# Idempotent and additive: a value already present is left alone, so an operator
# who set something by hand keeps it.
_slop_seed_cross_app_env() {
  local slopdir; slopdir="$(_git_root "$WD" 2>/dev/null || echo "$WD")"
  local envf="$slopdir/.env"
  [[ -f "$envf" ]] || return 0

  # ---- SSO: the secret and each app's trust flag ----------------------------
  #
  # These decide whether an app accepts the gateway's asserted identity or falls
  # back to its OWN login. install.sh writes them into each app's compose .env at
  # install time and NOTHING ever wrote them again — so if they were lost (an app
  # re-cloned, its .env regenerated, the app installed on its own), the app went
  # on serving a login form to an operator who had already signed in to SLOP, and
  # no command anywhere put it back. `slop update` now repairs it.
  #
  # SLOP's .env is authoritative, so a value that DISAGREES is corrected, not just
  # a missing one: a stale secret fails the constant-time compare exactly like an
  # absent one, and looks identical from the browser.
  local sso; sso="$(sed -n 's/^SYSIBLE_SSO_SHARED_SECRET=//p' "$envf" | tail -n1)"
  if [[ -n "$sso" ]]; then
    local entry ap trust adir aenv cur fixed
    for entry in "controller|SYSIBLE_WEBGUI_TRUST_SSO" \
                 "slep|SLEP_TRUST_GATEWAY_AUTH" \
                 "connect|SYSIBLE_CONNECT_TRUST_GATEWAY_AUTH"; do
      ap="${entry%%|*}"; trust="${entry##*|}"
      adir="$(_product_compose_dir "$ap")" || continue
      aenv="$adir/.env"
      fixed=0
      # `|| true`: under `set -euo pipefail` a sed against an app that has no .env
      # yet exits 2 and would take the whole update down before it could write one.
      cur="$(sed -n "s/^SYSIBLE_SSO_SHARED_SECRET=//p" "$aenv" 2>/dev/null | tail -n1 || true)"
      if [[ "$cur" != "$sso" ]]; then
        _env_upsert "$aenv" SYSIBLE_SSO_SHARED_SECRET "$sso"; fixed=1
        _warn "  $(_p_pretty "$ap") had ${cur:+a DIFFERENT}${cur:-no} SSO shared secret — corrected in $aenv"
      fi
      cur="$(sed -n "s/^${trust}=//p" "$aenv" 2>/dev/null | tail -n1 || true)"
      if [[ "$cur" != "1" ]]; then
        _env_upsert "$aenv" "$trust" 1; fixed=1
        _warn "  $(_p_pretty "$ap") was not set to trust the gateway ($trust=${cur:-unset}) — corrected in $aenv"
      fi
      if [[ $fixed -eq 1 ]]; then
        _warn "  Until it is recreated it keeps showing its OWN login to operators already signed in to SLOP."
        _recreate_product "$ap" \
          || _warn "  seeded $aenv, but could not recreate $ap — run 'sysible_ctl $ap update'."
      fi
    done
  else
    _warn "  No SYSIBLE_SSO_SHARED_SECRET in $envf — single sign-on cannot work and every"
    _warn "  app will show its own login. Re-run the SLOP installer to mint one."
  fi

  # Flashback's agent token: minted by the SLOP installer, consumed by the
  # Controller, which is the only thing that talks to Flashback's agent API.
  local tok; tok="$(sed -n 's/^SYSIBLE_FLASHBACK_AGENT_TOKEN=//p' "$envf" | tail -n1)"
  [[ -n "$tok" ]] || return 0

  local cdir; cdir="$(_product_compose_dir controller)" || return 0
  local cenv="$cdir/.env"
  local port; port="$(sed -n 's/^SYSIBLE_FLASHBACK_AGENT_PORT=//p' "$envf" | tail -n1)"
  [[ -n "$port" ]] || port=8770
  # host.docker.internal, not loopback: the Controller runs in a container and
  # Flashback publishes on the HOST. Its compose maps that name to the gateway.
  local changed=0
  _seed_kv "$cenv" SYSIBLE_FLASHBACK_URL "http://host.docker.internal:$port" \
    && { changed=1; _ok "Seeded SYSIBLE_FLASHBACK_URL into $cenv"; }
  _seed_kv "$cenv" SYSIBLE_FLASHBACK_AGENT_TOKEN "$tok" \
    && { changed=1; _ok "Seeded the Flashback agent token into $cenv"; }

  # A value written to .env is not a value the app HAS: docker reads .env when it
  # creates a container, so the Controller keeps running with the old environment
  # until it is recreated. Seeding without this was the same lie as everything
  # else in this feature's history — the setting existed and never reached the
  # process, and the operator was told it had been wired up.
  if [[ $changed -eq 1 ]]; then
    _recreate_product controller \
      || _warn "  seeded $cenv, but could not recreate the Controller — run 'sysible_ctl controller update' so it picks the new values up."
  fi
}

# Recreate a product from the images it already has, so it re-reads its .env.
# No --build: this exists for an environment change, and a rebuild would cost
# minutes for nothing.
_recreate_product() {
  local p="$1" dir cfg
  dir="$(_product_compose_dir "$p")" || return 1
  cfg="$(_compose_file_in "$dir")" || return 1
  _detect_compose
  _hdr "Recreating $(_p_pretty "$p") so it picks up the new settings"
  ( cd "$dir"; "${DC[@]}" -f "$cfg" up -d ) || return 1
  _ok "$(_p_pretty "$p") recreated with the seeded settings."
}

# Append KEY=VALUE to an env file if that key is not already set. Returns 0 when
# it wrote, 1 when it left an existing value alone.
_seed_kv() {
  local f="$1" k="$2" v="$3"
  [[ -n "$f" ]] || return 1
  if [[ -f "$f" ]] && grep -q "^${k}=" "$f"; then return 1; fi
  mkdir -p "$(dirname "$f")" 2>/dev/null || true
  printf '%s=%s\n' "$k" "$v" >> "$f" || return 1
  return 0
}

# The directory holding a product's compose file — where docker compose loads
# its .env from. Mirrors install.sh's _app_compose_dir.
_product_compose_dir() {
  local p="$1" c d
  if docker inspect "$(_p_container "$p")" >/dev/null 2>&1; then
    d="$(docker inspect -f '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' \
         "$(_p_container "$p")" 2>/dev/null || true)"
    [[ -n "$d" && -d "$d" ]] && { printf '%s\n' "$d"; return 0; }
  fi
  d="$(_p_dir_override "$p")"
  for c in "$d" "$d/deploy"; do
    [[ -n "$d" && -f "$c/docker-compose.yml" ]] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

# Did that git output say the remote could not be REACHED?
#
# Classifies the pull's OWN output rather than making a second network call: on a
# host that has lost DNS every probe costs another timeout, and the pull already
# said what was wrong. It turns "the code did not advance" into the one sentence
# that is true.
_git_says_unreachable() {
  case "$1" in
    *"Could not resolve host"*|*"Temporary failure in name resolution"*|\
    *"Could not resolve proxy"*|*"Connection timed out"*|\
    *"Network is unreachable"*|*"Failed to connect"*|*"Connection refused"*) return 0 ;;
  esac
  return 1
}

p_update() {
  local p="$1"
  # Fall back to the standard checkout location, exactly as `up` does. _discover
  # only knows a product by its CONTAINER or by SYSIBLE_<P>_DIR, so a product
  # whose container has been REMOVED (a failed build, a `compose down`) was
  # skipped by `update` even with its checkout sitting in /opt/sysible-src.
  #
  # For the Controller that is self-perpetuating and it bites hardest: THIS SCRIPT
  # lives in the Controller's checkout, so a missing Controller container meant
  # `update all` skipped the one pull that updates the CLI itself — and every fix
  # shipped to sysible_ctl stayed permanently out of reach of the operator who
  # most needed it. Updating a product you cannot currently see is the point: the
  # new code is usually what fixes it.
  if ! _discover "$p"; then
    local _ck; _ck="$(_find_checkout "$p" 2>/dev/null || true)"
    if [[ -n "$_ck" ]]; then
      CFG="$(_compose_file_in "$_ck")" && WD="$(dirname "$CFG")"
      _warn "$(_p_pretty "$p"): no container '$(_p_container "$p")' — updating its checkout at $_ck anyway."
    fi
  fi
  [[ -n "$CFG" ]] || { _warn "$(_p_pretty "$p"): not found — no container '$(_p_container "$p")', no SYSIBLE_${p^^}_DIR, and no checkout found. Skipping."; return 1; }
  _hdr "Updating $(_p_pretty "$p")"
  # Whether the SOURCE actually advanced. A failed pull used to be a yellow
  # warning followed by a green "updated" — so `update` rebuilt byte-identical
  # code and reported success, and the only symptom was that nothing changed.
  # Same class of lie as the gateway-config one below: the command has to say
  # when it did NOT bring in new code.
  local gr code_rc=0 before='' after=''
  if gr="$(_git_root "$WD")" && command -v git >/dev/null 2>&1; then
    before="$(git -C "$gr" rev-parse --short HEAD 2>/dev/null || true)"
    _hdr "Pulling latest code (git) in $gr"
    # Captured, not streamed, so the failure can be CLASSIFIED and not just shown.
    # Printed either way, unchanged.
    local pull_out pull_rc=0
    pull_out="$(git -C "$gr" pull --ff-only 2>&1)" || pull_rc=$?
    printf '%s\n' "$pull_out"
    if [[ $pull_rc -eq 0 ]]; then
      after="$(git -C "$gr" rev-parse --short HEAD 2>/dev/null || true)"
      if [[ -n "$before" && "$before" == "$after" ]]; then
        _ok "Already at ${after:-?} — no new commits to pull."
      else
        _ok "Code advanced: ${before:-?} -> ${after:-?}"
      fi
    else
      code_rc=1
      _err "git pull --ff-only FAILED in $gr — the code did NOT advance (still ${before:-?})."
      # Name the cause we can actually see. Listing three checkout problems when
      # the real fault is that the host cannot resolve github.com sends the
      # operator to investigate upstreams, local edits and detached HEADs — none
      # of which are wrong — while the machine simply has no DNS.
      if _git_says_unreachable "$pull_out"; then
        _err "  This host could not REACH github.com. That is a network/DNS fault, not a"
        _err "  problem with the checkout — nothing here needs fixing."
        _warn "  Check: getent hosts github.com ; cat /etc/resolv.conf ; ping -c1 1.1.1.1"
        _warn "  Every 'docker build' below will fail the same way, for the same reason."
      else
        _warn "Nothing new can be built until that checkout can fast-forward. Usual causes:"
        _warn "  * no upstream for this branch: git -C $gr status -sb"
        _warn "      fix: git -C $gr branch --set-upstream-to=origin/\$(git -C $gr branch --show-current)"
        _warn "  * local edits block the fast-forward: git -C $gr status --short"
        _warn "  * detached HEAD or a diverged branch: git -C $gr log --oneline -1"
      fi
    fi
  else
    code_rc=1
    _err "compose dir '$WD' is not a git checkout — an 'update' has no source to pull from, so it cannot bring in anything newer."
    _warn "Re-clone the product next to its compose file, or set SYSIBLE_${p^^}_DIR to a git checkout."
  fi
  _hdr "Rebuilding + recreating via compose ($CFG)"
  # CHECK IT. This exit status was discarded, and the cost was not theoretical: on
  # a host that had lost DNS, every `docker build` died at its FROM line, and the
  # command carried straight on to restart the gateway — so a failed update took
  # down a working front door. An update that could not build anything must leave
  # the running system exactly as it found it.
  if ! _compose up -d --build; then
    _err "$(_p_pretty "$p"): the build/recreate FAILED — see the output above."
    _warn "  Nothing was changed on the running system; it is still serving what it was."
    return 1
  fi
  # SLOP's gateway is the stock caddy image with a BIND-MOUNTED Caddyfile + portal,
  # so `up --build` recreates the built idp but leaves the gateway container as-is
  # (its image and compose config didn't change). A Caddyfile the git pull just
  # brought in would then sit on disk unloaded, so it has to be applied explicitly.
  # (The portal's static files are served live from the read-only mount — no reload.)
  local gw_rc=0
  if [[ "$p" == "slop" ]]; then
    _slop_seed_cross_app_env
    # ONLY when there is something to apply. The Caddyfile is bind-mounted and the
    # admin API is off, so "apply" means "restart the gateway" — and re-applying a
    # file Caddy already loaded was a self-inflicted outage window on every single
    # update, including ones that brought in nothing at all.
    if _slop_caddyfile_is_newer_than_gateway; then
      _slop_apply_gateway_config || gw_rc=1
    else
      _ok "Gateway config unchanged since the gateway started — leaving it alone."
    fi
  fi
  _hdr "New state"
  _compose ps 2>/dev/null || docker ps -a --filter "name=^/${CONTAINER}$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  local health_rc=0
  _health_wait "$p" || health_rc=1
  if [[ $gw_rc -ne 0 ]]; then
    # The images were rebuilt, but the gateway is NOT running the config that was
    # just pulled. Saying "updated" here is the lie that hid this for a whole day.
    _err "$(_p_pretty "$p"): images updated, but the gateway config was NOT applied (see above)."
    return 1
  fi
  if [[ $code_rc -ne 0 ]]; then
    # Containers were rebuilt and recreated, but from the SAME source as before.
    # Reporting "updated" here is what makes a broken checkout look like a no-op
    # update: the command goes green and the fix you pushed never ships.
    _err "$(_p_pretty "$p"): rebuilt from the code ALREADY on disk — the source never advanced, so this is not an update to newer code (see above)."
    return 1
  fi
  if [[ $health_rc -ne 0 ]]; then
    # Everything above may have succeeded and the thing still not serve. Reporting
    # "updated" over a product that answers nothing is the same lie as reporting a
    # bring-up that never started.
    _err "$(_p_pretty "$p"): updated, but it is not answering (see above)."
    return 1
  fi
  _ok "$(_p_pretty "$p") updated${after:+ to $after}. Volume '$(_p_volume "$p")' preserved."
}

# Has the Caddyfile changed since the running gateway read it?
#
# Asked of the FILE and the CONTAINER rather than of git, so a config edited by
# hand on the host is applied too — but a file Caddy already loaded is not, and
# that is the point: with `admin off` there is no reload, so every "apply" is a
# restart. Unknown (no container, no file, no stat) answers YES, because failing
# to apply a config that did change is the worse mistake of the two.
_slop_caddyfile_is_newer_than_gateway() {
  local gwc cf started_at started mtime
  gwc="$(_p_container slop)"
  cf="$(_git_root "$WD" 2>/dev/null || echo "$WD")/gateway/Caddyfile"
  [[ -f "$cf" ]] || return 0
  docker inspect "$gwc" >/dev/null 2>&1 || return 0
  started_at="$(docker inspect -f '{{.State.StartedAt}}' "$gwc" 2>/dev/null)" || return 0
  [[ -n "$started_at" ]] || return 0
  started="$(date -d "$started_at" +%s 2>/dev/null)" || return 0
  mtime="$(stat -c %Y "$cf" 2>/dev/null)" || return 0
  [[ -n "$started" && -n "$mtime" ]] || return 0
  (( mtime > started ))
}

# Load the on-disk Caddyfile into the running gateway, and PROVE it took.
#
# This is the whole authentication boundary: forward_auth plus the 401 -> /login
# deny path. An update that quietly fails to apply it leaves the fleet serving the
# previous — possibly vulnerable — config while reporting success.
#
# It used to be three lines whose failure paths all ended in /dev/null or `|| true`,
# and it failed in exactly that shape: `caddy reload` failed, its error was
# discarded, `docker restart` failed too, that was swallowed by `|| true`, and the
# update printed "updated" over a gateway still running the pre-fix Caddyfile. The
# giveaway was `ps` reporting "Up 19 hours" right after a supposed restart — a real
# restart resets that clock, so the container had never come back. Every step here
# is therefore checked, every error is shown, and the outcome is verified against
# the live gateway rather than inferred from an exit status.
_slop_apply_gateway_config() {
  local gwc out; gwc="$(_p_container slop)"
  if ! docker inspect "$gwc" >/dev/null 2>&1; then
    _warn "  no gateway container '$gwc' — skipping the config reload."
    _warn "  Set SYSIBLE_SLOP_CONTAINER if the gateway runs under another name."
    return 0
  fi
  _hdr "Applying the gateway (Caddy) config"

  # Validate BEFORE touching the running server. Caddy refuses to start on an
  # invalid config, so restarting into one turns a working gateway into a down
  # one — the worst possible outcome of an update. Keep serving the old config
  # and say so instead.
  if ! out="$(docker exec "$gwc" caddy validate --config /etc/caddy/Caddyfile 2>&1)"; then
    _err "the Caddyfile on disk is INVALID — refusing to apply it. The gateway is"
    _err "still serving its previous config. Fix the file, then re-run this update."
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    return 1
  fi

  # Reload = zero downtime. On failure keep the output: it is the diagnosis.
  if out="$(docker exec "$gwc" caddy reload --config /etc/caddy/Caddyfile 2>&1)"; then
    _ok "  gateway config reloaded"
  else
    # Expected, not a fault: gateway/Caddyfile sets `admin off`, so there is no
    # admin API to POST a new config to and `caddy reload` can never succeed
    # here. The restart IS the apply path; say so rather than presenting a
    # guaranteed failure as a surprise.
    if [[ "$out" == *"connect: connection refused"* ]]; then
      _warn "  the gateway's admin API is off (by design), so applying means a restart"
    else
      _warn "  caddy reload failed — restarting the gateway to apply changes"
      printf '%s\n' "$out" | sed 's/^/    /' >&2
    fi
    if ! out="$(docker restart "$gwc" 2>&1)"; then
      _err "the gateway could not be restarted either, so the new config is NOT live —"
      _err "it is still running the previous one. docker said:"
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      return 1
    fi
    _ok "  gateway restarted"
  fi

  _slop_verify_gateway_denies
}

# Prove the gateway is enforcing auth, instead of trusting that a reload did what
# it said. An anonymous request for the portal apex must be bounced to the sign-in
# page. A 200 means the deny path is a no-op and every app behind the gateway is
# being served to anyone — which has happened once already: inside handle_response
# `redir /login?... 302` parses as a MATCHER plus destination "302", so the 401
# branch matched nothing and requests fell through as if signed in. It adapted,
# started, and logged no warning (gateway/tests/test_caddyfile.py pins the syntax;
# this pins the behaviour of the gateway actually running).
_slop_verify_gateway_denies() {
  local port code i
  port="$(_p_port slop)"
  command -v curl >/dev/null 2>&1 || {
    _warn "  curl is not installed — cannot verify that the gateway denies anonymous requests."
    return 0
  }
  # Up to ~15s: the idp is rebuilt by the same update, and while it is starting
  # forward_auth has nothing to ask, so a transient 502 here is expected.
  #
  # 127.0.0.1, NOT localhost — and this one matters more than the health probe.
  # curl sends SNI for a hostname; the gateway has a cert only for its internal
  # cert-holder name and serves it via default_sni to clients that send NONE, so a
  # request to https://localhost/ is refused at the TLS handshake and never
  # produces an HTTP status at all. This loop would then spin out all 15 seconds,
  # report "could not verify the gateway's deny path (last HTTP status: none)" and
  # RETURN 0 — so the check that exists to catch "every app behind the gateway is
  # being served to anyone" could never once have run on a real install. It failed
  # open, quietly, which is the worst way for a security check to fail.
  for i in $(seq 1 15); do
    code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "https://127.0.0.1:${port}/" 2>/dev/null || true)"
    case "$code" in
      30[1237]) _ok "  verified: anonymous requests are redirected to sign-in ($code)"; return 0 ;;
      200)      _err "the gateway served the portal to an UNAUTHENTICATED request (HTTP 200)."
                _err "The forward_auth deny path is not firing — every app behind the gateway is"
                _err "exposed. Do not leave this running: check gateway/Caddyfile for a directive"
                _err "inside handle_response with no explicit '*' matcher."
                return 1 ;;
    esac
    sleep 1
  done
  _warn "  could not verify the gateway's deny path (last HTTP status: ${code:-none})."
  _warn "  Check it by hand: curl -sk -o /dev/null -w '%{http_code}\\n' https://127.0.0.1:${port}/  (expect 302)"
  return 0
}

# Which apps BEHIND the gateway are actually reachable from it.
#
# The gateway being up says nothing about the three apps it fronts, and the
# difference is invisible from `ps`: an operator whose console is full of 502s
# sees "sysible-slop-gateway  Up 2 hours" and every SLOP container healthy, with
# nothing anywhere naming the app that is down. The gateway already publishes the
# answer at /healthz/<app> (public, up/down only) — this just asks it, from the
# same side of the proxy the browser is on.
_slop_upstream_status() {
  local app port code
  command -v curl >/dev/null 2>&1 || return 0
  port="$(_p_port slop)"
  _hdr "Apps behind the gateway"
  for app in controller slep connect; do
    code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 \
            "https://127.0.0.1:${port}/healthz/${app}" 2>/dev/null || true)"
    case "$code" in
      2*)         _ok "  $(_p_pretty "$app"): reachable from the gateway ($code)" ;;
      50[234])    _warn "  $(_p_pretty "$app"): the gateway cannot reach it ($code) — its container is"
                  _warn "    not running or not listening on port $(_p_port "$app"). Try: $(basename "$0") $app up" ;;
      ""|000)     _warn "  $(_p_pretty "$app"): no answer from the gateway at all — the gateway is down."; return 0 ;;
      *)          _warn "  $(_p_pretty "$app"): the gateway answered $code for its health path" ;;
    esac
  done
}

p_status() {
  local p="$1"
  _hdr "$(_p_pretty "$p")"
  # A multi-service stack: list every service via compose; otherwise the one container.
  if _discover "$p"; then _compose ps 2>/dev/null || true
  else docker ps -a --filter "name=^/$(_p_container "$p")$" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | tail -n +1; fi
  _health "$p" || true
  [[ "$p" == "slop" ]] && { _slop_upstream_status; _flashback_status; }
  return 0
}

# Config backup (Flashback) status.
#
# Flashback is a service inside the slop compose, so `ps` shows its container and
# nothing more — and "Up 4 hours" is exactly what it said all the way through an
# outage where no host could back anything up. Running is not the same as working
# here: capture needs an agent token on BOTH sides, and the Controller reaching
# Flashback over the host. This reports the chain, not the container.
_flashback_status() {
  local fbc="${SYSIBLE_FLASHBACK_CONTAINER:-sysible-flashback}"
  docker inspect "$fbc" >/dev/null 2>&1 || return 0     # not deployed here
  _hdr "Sysible Flashback (config backup)"

  local up; up="$(docker inspect -f '{{.State.Status}}' "$fbc" 2>/dev/null || echo unknown)"
  printf '  container: %s\n' "$up"

  # Both halves of the token. Flashback FAILS CLOSED without one, so an unset
  # token means every snapshot is refused — silently, from the console's side.
  local fbtok ctok
  fbtok="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$fbc" 2>/dev/null \
           | sed -n 's/^SYSIBLE_FLASHBACK_AGENT_TOKEN=//p' | tail -n1)"
  local ctlc; ctlc="$(_p_container controller)"
  local cenv=""
  docker inspect "$ctlc" >/dev/null 2>&1 && \
    cenv="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$ctlc" 2>/dev/null)"
  ctok="$(printf '%s\n' "$cenv" | sed -n 's/^SYSIBLE_FLASHBACK_AGENT_TOKEN=//p' | tail -n1)"
  local curl_url; curl_url="$(printf '%s\n' "$cenv" | sed -n 's/^SYSIBLE_FLASHBACK_URL=//p' | tail -n1)"

  if [[ -z "$fbtok" ]]; then
    _err "  agent token: NOT SET on Flashback — it refuses every snapshot (fails closed)."
    _warn "    fix: add SYSIBLE_FLASHBACK_AGENT_TOKEN to the SLOP .env, then 'sysible_ctl slop update'"
  elif [[ -z "$ctok" ]]; then
    _err "  agent token: set on Flashback but MISSING on the Controller — nothing can post a backup."
    _warn "    fix: 'sysible_ctl slop update' seeds it, then 'sysible_ctl controller update'"
  elif [[ "$fbtok" != "$ctok" ]]; then
    _err "  agent token: the two sides DO NOT MATCH — every snapshot is rejected 401."
    _warn "    fix: re-run 'sysible_ctl slop update' so both take the SLOP .env value"
  else
    _ok "  agent token: matches on both sides"
  fi

  [[ -n "$curl_url" ]] && printf '  controller reaches it at: %s\n' "$curl_url"

  # Does the Controller ACTUALLY reach it? The wiring can be perfect and the URL
  # still point at the container's own loopback instead of the host.
  if [[ -n "$ctok" && -n "$curl_url" ]] && docker inspect "$ctlc" >/dev/null 2>&1; then
    local code
    code="$(docker exec "$ctlc" python -c "
import os,urllib.request
try:
    r=urllib.request.urlopen(os.environ['SYSIBLE_FLASHBACK_URL'].rstrip('/')+'/api/health',timeout=5)
    print(r.status)
except Exception as e:
    print(type(e).__name__)
" 2>/dev/null | tail -n1)"
    if [[ "$code" == "200" ]]; then
      _ok "  controller -> Flashback: reachable"
    else
      _err "  controller -> Flashback: UNREACHABLE ($code) — backups cannot be delivered."
    fi
  fi

  # How many hosts have actually reported, straight from the version store.
  local hosts
  hosts="$(docker exec "$fbc" python -c "
import sys
sys.path.insert(0,'/app')
from backend import store
h=store.list_hosts()
print(len(h), sum(x.get('versions') or 0 for x in h))
" 2>/dev/null | tail -n1)"
  if [[ -n "$hosts" ]]; then
    set -- $hosts
    if [[ "${1:-0}" == "0" ]]; then
      _warn "  stored backups: none yet (no host has reported a snapshot)"
    else
      _ok "  stored backups: ${1} host(s), ${2} version(s)"
    fi
  fi
}

# Lifecycle: drive the whole compose stack when we can discover it (correct for a
# multi-service stack), else fall back to the single container.
p_logs()    { if _discover "$1"; then _compose logs -f --tail="${2:-200}"; else docker logs -f --tail="${2:-200}" "$(_p_container "$1")"; fi; }
p_restart() { _hdr "Restarting $(_p_pretty "$1")"; if _discover "$1"; then _compose restart; else docker restart "$(_p_container "$1")" >/dev/null; fi && _ok "restarted"; }
p_start()   { _hdr "Starting $(_p_pretty "$1")";   if _discover "$1"; then _compose start;   else docker start   "$(_p_container "$1")" >/dev/null; fi && _ok "started"; }
p_stop()    { _hdr "Stopping $(_p_pretty "$1")";   if _discover "$1"; then _compose stop;    else docker stop    "$(_p_container "$1")" >/dev/null; fi && _ok "stopped (data volumes preserved)"; }

p_backup() {
  local p="$1" stamp file vol
  stamp="$(date +%Y%m%d-%H%M%S)"
  # One tarball per named volume (a product may keep state in several).
  for vol in $(_p_volume "$p"); do
    file="${vol}-backup-${stamp}.tgz"
    if docker volume inspect "$vol" >/dev/null 2>&1; then
      _hdr "Backing up volume '$vol' -> $PWD/$file"
      docker run --rm -v "${vol}:/data:ro" -v "$PWD:/backup" alpine tar czf "/backup/${file}" -C /data .
      _ok "  wrote $PWD/$file"
    else
      _warn "  volume '$vol' not found — skipping (is $(_p_pretty "$p") deployed here?)"
    fi
  done
}

p_destroy() {
  local p="$1" with_vol="${2:-0}"
  if _discover "$p"; then
    if [[ "$with_vol" == "1" ]]; then _compose down -v; else _compose down; fi
  else
    docker rm -f "$(_p_container "$p")" >/dev/null 2>&1 || true
  fi
  _ok "$(_p_pretty "$p") removed.$([[ "$with_vol" == "1" ]] && echo ' Data volume DELETED.' || echo " Volume '$(_p_volume "$p")' kept.")"
}

# First-run bring-up from a checkout (before any container exists). For the
# controller it also seeds .env with the host's reachable address — agents must
# reach it at a routable IP/DNS, not the docker-bridge IP. (Folds in the old
# start-container.sh.) Re-run any time to rebuild + roll to the latest code.
# _env_upsert FILE KEY VALUE — set KEY=VALUE in an env file, replace-or-append,
# PRESERVING every other line (0600). Used so writing the controller's advertised
# address never clobbers the SSO secret / trust flag / base path that install.sh
# (or a manual edit) put in the same .env — the two used to overwrite each other.
_env_upsert() {
  local f="$1" k="$2" v="$3" t
  [[ -f "$f" ]] || ( umask 077; : > "$f" )
  chmod 600 "$f" 2>/dev/null || true
  if grep -q "^$k=" "$f" 2>/dev/null; then
    t="$f.tmp.$$"; ( umask 077; : > "$t" )
    if sed "s|^$k=.*|$k=$v|" "$f" > "$t"; then mv "$t" "$f"; else rm -f "$t"; fi
    chmod 600 "$f" 2>/dev/null || true
  else
    printf '%s=%s\n' "$k" "$v" >> "$f"
  fi
}

# Is the SSO shared secret available to compose for the slop stack? Compose reads
# it from the ambient environment or from the .env beside the compose file.
_slop_secret_present() {
  local dir="$1" cfg="$2" envf
  [[ -n "${SYSIBLE_SSO_SHARED_SECRET:-}" ]] && return 0
  envf="$(dirname "$cfg")/.env"
  [[ -f "$envf" ]] && grep -q '^SYSIBLE_SSO_SHARED_SECRET=..*$' "$envf" && return 0
  # install.sh keeps the canonical copy at the repo root, which may differ from
  # the compose dir when the compose file lives under deploy/.
  [[ -f "$dir/.env" ]] && grep -q '^SYSIBLE_SSO_SHARED_SECRET=..*$' "$dir/.env" && return 0
  return 1
}

p_up() {
  local p="$1"; shift || true
  local dir cfg
  dir="$(_p_dir_override "$p")"
  if [[ -z "$dir" ]] && _discover "$p"; then dir="$WD"; fi
  if [[ -z "$dir" && "$p" == "controller" ]]; then dir="$_CTL_REPO"; fi
  # Standard clone location (install.sh's /opt/sysible-src/<repo>) before giving up.
  if [[ -z "$dir" ]]; then dir="$(_find_checkout "$p" || true)"; fi
  # RETURN, never _die: _die exits the whole process, so one product without a
  # checkout used to abort an entire `up all` and silently skip the rest.
  if [[ -z "$dir" ]]; then
    _err "$(_p_pretty "$p"): can't find its checkout. Clone it (or set SYSIBLE_${p^^}_DIR=/path/to/checkout) and re-run."
    return 1
  fi
  cfg="$(_compose_file_in "$dir")" || _die "$(_p_pretty "$p"): no docker-compose.yml under $dir (or $dir/deploy)."
  _detect_compose

  local envargs=() addr=""
  # The controller must advertise a routable address to agents (not the
  # docker-bridge IP), so seed .env next to the compose file's project dir.
  if [[ "$p" == "controller" ]]; then
    addr="${1:-${SYSIBLE_CONTROLLER_ADDR:-}}"
    [[ -n "$addr" ]] || addr="$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
    [[ -n "$addr" ]] || _die "couldn't auto-detect this host's LAN IP. Pass it: sysible_ctl $p up <lan-ip-or-dns>"
    local envdir envf; envdir="$(dirname "$cfg")"   # compose loads .env from its own dir
    envf="$envdir/.env"
    # MERGE the advertised-address keys in — never overwrite the file, or we'd wipe
    # SYSIBLE_SSO_SHARED_SECRET / trust / base path that live here too (SSO breaks).
    _env_upsert "$envf" SYSIBLE_CONTROLLER_ADDR "$addr"
    _env_upsert "$envf" SYSIBLE_CONTROLLER_HOSTNAMES "$addr,localhost"
    _env_upsert "$envf" SYSIBLE_TLS_HOSTS "$addr,localhost"
    _ok "Updated $envf (controller address $addr; other keys preserved)."
    envargs=(--env-file "$envf")
  fi

  # SLOP's compose REQUIRES the SSO shared secret: five services declare it with
  # ${VAR:?...}, so a bare `compose up` aborts outright when it is unset. On a
  # first bring-up there is no .env yet — nothing has minted the secret — so
  # `sysible_ctl slop up` failed instantly and SLOP never installed. Its own
  # install.sh is the supported first-run path: it mints the secret, writes the
  # .env every later `up` then reads, and seeds the apps. Hand off to it, and only
  # for the gateway, since the apps are brought up separately.
  if [[ "$p" == "slop" ]] && ! _slop_secret_present "$dir" "$cfg"; then
    if [[ -f "$dir/install.sh" ]]; then
      _hdr "First bring-up of $(_p_pretty "$p") — running $dir/install.sh gateway"
      _warn "(a bare 'compose up' cannot work yet: the SSO shared secret has not been minted)"
      ( cd "$dir"; sh ./install.sh gateway ) || {
        _err "$(_p_pretty "$p"): install.sh gateway failed — see the output above."; return 1; }
      _health "$p" || true
      _ok "$(_p_pretty "$p") is up."
      return 0
    fi
    _err "$(_p_pretty "$p"): no SSO shared secret and no install.sh at $dir — compose would abort."
    _warn "  fix: set SYSIBLE_SSO_SHARED_SECRET in $(dirname "$cfg")/.env, or re-clone the platform repo."
    return 1
  fi

  _hdr "Building + starting $(_p_pretty "$p") from $dir"
  # CHECK IT. This ran in a subshell whose exit status was thrown away, so a build
  # that failed, or a container that could not bind its port, still reached the
  # "is up." line below — and install.sh, reading only the exit code, reported the
  # gateway as up. That is how a dead front door gets announced as a success.
  if ! ( cd "$(dirname "$cfg")"; "${DC[@]}" -f "$cfg" "${envargs[@]}" up -d --build ); then
    _err "$(_p_pretty "$p"): compose failed to build or start it (see the output above)."
    return 1
  fi
  # The gateway is the stock caddy image with a BIND-MOUNTED Caddyfile, so
  # `up --build` rebuilds the other services and leaves it running its OLD config.
  # `update` has always known this; `up` did not, so a Caddyfile that arrived with
  # a git pull sat on disk unloaded and the front door kept serving the previous
  # one. Same apply + prove-it path as update, for the same reason.
  if [[ "$p" == "slop" ]]; then
    # _slop_seed_cross_app_env reads $WD to find the SLOP checkout; p_update gets
    # it from _discover, and p_up may not have run that.
    WD="$(dirname "$cfg")"
    _slop_seed_cross_app_env
    if ! _slop_apply_gateway_config; then
      _err "$(_p_pretty "$p"): started, but the gateway config was NOT applied (see above)."
      return 1
    fi
  fi
  _health_wait "$p" || return 1
  _ok "$(_p_pretty "$p") is up. Volume(s) '$(_p_volume "$p")' persist across rebuilds."
  [[ "$p" == "controller" && -n "$addr" ]] && cat <<EOF
  Web console : https://$addr:8800/   (first run: create your administrator)
  Agent API   : https://$addr:9000/   (SLEP + agents connect here)
EOF
  return 0
}

# Locate the SLOP checkout (which carries the whole-stack installer). Prefers an
# explicit SYSIBLE_SLOP_DIR, then a SLOP-looking current dir, then common paths.
# Standard checkout locations for a product, tried in order. install.sh clones
# every app to $SYSIBLE_SRC_DIR (default /opt/sysible-src)/<repo-name>, so a stock
# install is discoverable WITHOUT the operator exporting SYSIBLE_<P>_DIR. Without
# this, `up all` on a fresh box could only find whatever happened to be running.
_p_repo_dir() { case "$1" in
  controller)    echo "sysible-controller" ;;
  slep)          echo "sysible-linux-engineering-platform" ;;
  connect)       echo "sysible-connect" ;;
  slop)          echo "sysible-linux-operations-platform" ;;
esac; }

_find_checkout() {  # _find_checkout <product> -> prints dir, or returns 1
  local p="$1" repo d parent src="${SYSIBLE_SRC_DIR:-/opt/sysible-src}"
  repo="$(_p_repo_dir "$p")" || return 1
  [[ -n "$repo" ]] || return 1
  for d in "$src/$repo" "/opt/$repo" "$HOME/$repo" "$(dirname "$_CTL_REPO")/$repo"; do
    [[ -n "$d" && -d "$d" ]] || continue
    # A real checkout has a compose file (at the root or under deploy/).
    if _app_compose_dir_of "$d" >/dev/null; then printf '%s\n' "$d"; return 0; fi
  done
  # Same name, different case. `git clone` takes the directory name straight from
  # the URL, and these repos' URL casing has changed over time — so a real
  # checkout can sit at /opt/Sysible-Controller while this looks for
  # /opt/sysible-controller. On a case-sensitive filesystem that is one capital
  # letter between "found" and "not installed", and `update` skipped the product
  # entirely on the strength of it.
  for parent in "$src" /opt "$HOME" "$(dirname "$_CTL_REPO")"; do
    [[ -n "$parent" && -d "$parent" ]] || continue
    while IFS= read -r d; do
      [[ -n "$d" ]] || continue
      if _app_compose_dir_of "$d" >/dev/null; then printf '%s\n' "$d"; return 0; fi
    done < <(find "$parent" -maxdepth 1 -mindepth 1 -type d -iname "$repo" 2>/dev/null)
  done
  return 1
}

_app_compose_dir_of() {  # the dir holding <d>'s compose file, or 1
  local d="$1" sub f
  for sub in "$d" "$d/deploy"; do
    for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
      [[ -f "$sub/$f" ]] && { printf '%s\n' "$sub"; return 0; }
    done
  done
  return 1
}

_find_slop_dir() {
  local d
  for d in "${SYSIBLE_SLOP_DIR:-}" "$PWD" \
           /opt/sysible-linux-operations-platform /opt/Sysible-Linux-Operations-Platform \
           /opt/sysible-src/sysible-linux-operations-platform "$HOME/sysible-linux-operations-platform"; do
    [[ -n "$d" ]] || continue
    if [[ -f "$d/install.sh" && -f "$d/gateway/Caddyfile" ]]; then printf '%s\n' "$d"; return 0; fi
  done
  return 1
}

# The SLOP portal URL. There is NO domain: SLOP answers on 443 for whatever IP
# this host has, so we print the host's primary IP. Shown after a bring-up so the
# user knows where to go.
_slop_url() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  printf 'https://%s/\n' "${ip:-<this-host-IP>}"
}

# Run a command across every present product.
p_all() {
  local cmd="$1"; shift || true
  local any=0 p failed=""
  for p in $PRODUCTS; do
    # For a bring-up, attempt every product whose checkout we can find — not just
    # the ones already built, or `up all` could never install anything new.
    #
    # `update` needs the same reach, for a sharper reason: _present is false once a
    # container has been REMOVED, so `update all` silently skipped any product in
    # that state — including the Controller, whose checkout is where THIS SCRIPT
    # lives. A removed Controller container therefore froze the CLI at whatever
    # version was on disk, so the fix for the failure in front of the operator
    # could never arrive. Pulling new code into a checkout is safe whether or not
    # anything is running.
    if _present "$p" || { [[ "$cmd" == "up" || "$cmd" == "update" ]] && _find_checkout "$p" >/dev/null 2>&1; }; then
      any=1
      "p_$cmd" "$p" "$@" || failed="$failed $p"
      echo
    fi
  done
  if [[ -n "$failed" ]]; then
    _warn "Completed with problems:$failed"
    _warn "The other products above were still processed — re-run for just one with: $(basename "$0") <product> $cmd"
  fi
  if [[ $any -eq 0 ]]; then
    # Nothing is built yet. For a bring-up intent, the first-run path is the SLOP
    # installer (clone + build + start the whole stack) — run it if we can find it,
    # since that's what 'start all' is expected to do on a fresh box.
    case "$cmd" in
      start|restart|up)
        local slop
        if slop="$(_find_slop_dir)"; then
          _hdr "Nothing is built yet — running the first-run bring-up: $slop/install.sh"
          if [[ $EUID -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
            exec sudo -- sh "$slop/install.sh"
          fi
          exec sh "$slop/install.sh"
        fi
        _warn "Nothing is built yet, and no SLOP checkout was found to bootstrap from."
        _warn "Run the whole-stack installer from the SLOP repo:  sudo ./install.sh"
        _warn "(or set SYSIBLE_SLOP_DIR=/path/to/sysible-linux-operations-platform and retry)."
        return 0
        ;;
    esac
    _warn "No Sysible product containers found. Bring the stack up first:  sudo ./install.sh  (from the SLOP repo)."
    return 0
  fi
  # After a successful bring-up, tell the user where the front door is.
  case "$cmd" in
    start|restart|up) _present slop && { _ok "SLOP portal: $(_slop_url)"; } ;;
  esac
}

# =========================================================
# install / help
# =========================================================
cmd_install() {
  local name="sysible_ctl" bindir dest
  if [[ -w /usr/local/bin || "$(id -u)" -eq 0 ]]; then bindir=/usr/local/bin; else bindir="$HOME/.local/bin"; mkdir -p "$bindir"; fi
  dest="$bindir/$name"; chmod +x "$SELF"; ln -sf "$SELF" "$dest"
  _ok "Linked $dest -> $SELF"
  case ":$PATH:" in *":$bindir:"*) _ok "Ready — run: ${BOLD}$name status${RESET}" ;;
    *) _warn "$bindir is not on your PATH. Add it:  echo 'export PATH=\"$bindir:\$PATH\"' >> ~/.bashrc && source ~/.bashrc" ;;
  esac
}
cmd_uninstall() {
  local removed=0 d
  for d in /usr/local/bin/sysible_ctl "$HOME/.local/bin/sysible_ctl"; do
    [[ -L "$d" || -f "$d" ]] && rm -f "$d" && { _ok "Removed $d"; removed=1; }
  done
  [[ $removed -eq 1 ]] || _warn "No installed 'sysible_ctl' found."
}

KNOWN_CMDS="up build update status logs restart start stop backup destroy"

usage() {
  local me; me="$(basename "$0")"
  cat <<EOF
${BOLD}sysible_ctl${RESET} — manage every Sysible product container from one CLI

One tool for every Sysible product. 'update' git-pulls the checkout, rebuilds from
source, and recreates the container IN PLACE — your data volume is never touched,
so DBs, TLS certs, keys, users and files survive every update.

${BOLD}USAGE${RESET}
  $me ${CYAN}<product>${RESET} <command> [args]      e.g. $me controller update
  $me <command> ${CYAN}all${RESET}                  e.g. $me update all
  $me ${CYAN}<product>${RESET}                       (no command) → status of that product
  $me ${CYAN}status${RESET}|${CYAN}start${RESET}|${CYAN}stop${RESET}|${CYAN}restart${RESET}|${CYAN}up${RESET}    (no product) → act on EVERY product

  ${BOLD}Build + start EVERYTHING (what most people want):${RESET}
    ${BOLD}$me install all${RESET}   — build every product from source and start it
    (identical: '$me build all', '$me up all', or bare '$me up')

${BOLD}PRODUCTS${RESET}
  ${CYAN}controller${RESET}   Sysible Controller — console :8800, agent API :9000   (alias: ce)
  ${CYAN}slep${RESET}         Sysible Linux Engineering Platform — console :8810
  ${CYAN}connect${RESET}      Sysible Connect — :8700
  ${CYAN}slop${RESET}         SLOP gateway — front door (Caddy + IdP + Flashback) on :443

${BOLD}COMMANDS${RESET}
  ${CYAN}up${RESET}        First-run bring-up (or re-roll) from a checkout: BUILD from source
              and start. Re-runnable any time to roll to the latest code.
              Usually written ${BOLD}install all${RESET}. Aliases: ${BOLD}install${RESET} <all|product>,
              ${BOLD}build${RESET}, ${BOLD}up${RESET}. (Bare '${BOLD}install${RESET}' with NO target puts this CLI on
              your PATH — it does not build anything.)
  ${CYAN}update${RESET}    git pull the checkout + rebuild from source + recreate in place.
              Data volume preserved. (For slop, also hot-reloads the gateway.)
  ${CYAN}status${RESET}    Container state + console health probe.
  ${CYAN}logs${RESET}      Follow logs. Default tail 200; pass a number for more/less.
  ${CYAN}start${RESET}     Start a stopped container.
  ${CYAN}stop${RESET}      Stop the container (data volume kept).
  ${CYAN}restart${RESET}   Restart the container.
  ${CYAN}backup${RESET}    Tarball the product's data volume(s) into the current directory.
  ${CYAN}destroy${RESET}   Remove the container. Add ${BOLD}-v${RESET} to ALSO delete its data volume.

${BOLD}EXAMPLES — updating${RESET}
  $me update all                    # git pull + rebuild + recreate EVERY product
  $me controller update             # just the Controller
  $me slep update                   # just SLEP
  $me connect update                # just Connect
  $me slop update                   # just the SLOP gateway (+ Caddy hot-reload)

${BOLD}EXAMPLES — status & logs${RESET}
  $me status                        # overview of every product (state + health)
  $me slep                          # short for: $me slep status
  $me controller logs               # follow Controller logs (last 200 lines)
  $me slop logs 1000                # follow gateway logs, last 1000 lines

${BOLD}EXAMPLES — lifecycle${RESET}
  $me start                         # start ALL products   (= '$me start all')
  $me stop                          # stop ALL products
  $me restart                       # restart ALL products
  $me controller restart            # restart just the Controller
  $me connect stop                  # stop just Connect (its data volume is kept)

${BOLD}EXAMPLES — build + start
  sysible_ctl install all                   # BUILD from source + start EVERY product
  sysible_ctl build all                     # identical (alias)
  sysible_ctl up all                        # identical (alias)
  sysible_ctl up                            # identical (bare command = all)
  sysible_ctl install slep                  # build + start just SLEP
  sysible_ctl slep build                    # identical
  A product with no checkout is REPORTED and SKIPPED — the others still come up.

EXAMPLES — first-run bring-up${RESET}
  sudo ./install.sh                 # (from the SLOP repo) the whole stack, easiest
  $me controller up 192.168.1.50    # Controller, advertising this LAN IP to agents
  $me controller up                 # auto-detect the LAN IP
  SYSIBLE_SLEP_DIR=/opt/sysible-slep $me slep up
  SYSIBLE_SLOP_DIR=/opt/sysible-linux-operations-platform $me slop up

${BOLD}EXAMPLES — backup & restore${RESET}
  $me controller backup             # writes sysible-data-backup-<stamp>.tgz here
  $me slop backup                   # backs up the IdP user store + the Caddy CA/certs
  # restore a volume from a tarball (stop the product first):
  $me controller stop
  docker run --rm -v sysible-data:/data -v "\$PWD:/backup" alpine \\
    sh -c 'rm -rf /data/* && tar xzf /backup/sysible-data-backup-<stamp>.tgz -C /data'
  $me controller start

${BOLD}EXAMPLES — teardown${RESET}
  $me connect destroy               # remove the container, KEEP the data volume
  $me connect destroy -v            # remove the container AND delete the data volume

${BOLD}FINDING PRODUCTS${RESET}
Each product is discovered automatically from its running container's compose
labels — no matter where the repo lives. If a container ISN'T running yet, point
the tool at its checkout with SYSIBLE_<PRODUCT>_DIR:
  SYSIBLE_CONTROLLER_DIR=/opt/sysible-controller   $me controller up
  SYSIBLE_SLEP_DIR=/opt/sysible-slep               $me slep update
  SYSIBLE_CONNECT_DIR=/opt/sysible-connect         $me connect up
  SYSIBLE_SLOP_DIR=/opt/sysible-linux-operations-platform  $me slop up
Override a container name with SYSIBLE_<PRODUCT>_CONTAINER if you renamed it.

${BOLD}SLOP GATEWAY (slop)${RESET}
The front door (Caddy + IdP) that fronts the other three apps over ONE origin,
path-routed: /controller /slep /connect. It does NOT start/stop the apps — bring
the apps up first, then the door. There is NO domain to set: SLOP serves on 443
for whatever IP this host has, at https://<server-ip>/ (accept the one-time
self-signed cert warning). The SSO shared secret + app upstreams live in the SLOP
checkout's .env (copy .env.example). 'slop update' git-pulls that checkout,
rebuilds the IdP, recreates changed services, and hot-reloads Caddy so a pulled
Caddyfile/portal takes effect with no downtime.

${BOLD}META${RESET}
  $me install                       # put this CLI on your PATH as 'sysible_ctl'
  $me uninstall                     # remove it from your PATH
  $me help                          # this help

${BOLD}NOTES${RESET}
  • 'update' NEVER deletes a data volume — only 'destroy -v' does.
  • Docker socket denied? The tool re-runs itself under sudo automatically. To
    skip sudo: sudo usermod -aG docker \$USER  then log out/in (or: newgrp docker).
  • First time on a box: ${BOLD}sudo ./deploy/sysible_ctl install${RESET}, then run '$me …' anywhere.
EOF
}

# =========================================================
# Dispatch
# =========================================================
_canon_cmd() { case "$1" in build) echo up ;; *) echo "$1" ;; esac; }

_run_cmd() {  # _run_cmd <cmd> <product> [args…]  — validates cmd, handles -v for destroy
  local cmd; cmd="$(_canon_cmd "$1")"; local p="$2"; shift 2 || true
  case " $KNOWN_CMDS " in *" $cmd "*) ;; *) _die "unknown command: $cmd (try: $(basename "$0") help)" ;; esac
  _need_docker
  if [[ "$cmd" == "destroy" ]]; then
    local wv=0; case "${1:-}" in -v|--volumes) wv=1 ;; esac
    p_destroy "$p" "$wv"; return
  fi
  "p_$cmd" "$p" "$@"
}

main() {
  _ARGV=("$@")   # original args, for a transparent sudo re-exec in _need_docker
  local a1="${1:-help}" a2="${2:-}"
  case "$a1" in
    help|-h|--help) usage; return 0 ;;
    install)
      # Bare `install` puts THIS CLI on PATH. `install all` (or `install <product>`)
      # is what people reach for to build the products — route it to `up`.
      # A target that is neither must be an ERROR: falling through to cmd_install
      # would answer a typo ('install slpe') by silently linking the CLI, which
      # looks like success and builds nothing.
      if [[ -n "$a2" ]]; then
        if [[ "$a2" == "all" ]]; then _need_docker; p_all up; return 0; fi
        if _is_product "$a2"; then _need_docker; _run_cmd up "$(_canon "$a2")"; return 0; fi
        _die "install: '$a2' is not a product. Use 'all', or one of: $PRODUCTS"
      fi
      cmd_install; return 0 ;;
    uninstall)      cmd_uninstall; return 0 ;;
  esac

  # Form:  sysible_ctl <product> <cmd> [args]   (product may be an alias, e.g. ce)
  if _is_product "$a1"; then
    local prod; prod="$(_canon "$a1")"
    [[ -n "$a2" ]] || { p_status "$prod"; return 0; }
    shift 2 || true
    _run_cmd "$a2" "$prod" "$@"
    return 0
  fi

  # Form:  sysible_ctl all <cmd>   or   sysible_ctl <cmd> all
  _need_docker
  if [[ "$a1" == "all" ]]; then
    local cmd; cmd="$(_canon_cmd "${a2:-status}")"
    case " $KNOWN_CMDS " in *" $cmd "*) ;; *) _die "unknown command: $cmd" ;; esac
    p_all "$cmd"; return 0
  fi
  if [[ "$a2" == "all" ]]; then
    local cmd2; cmd2="$(_canon_cmd "$a1")"
    case " $KNOWN_CMDS " in *" $cmd2 "*) ;; *) _die "unknown command: $a1" ;; esac
    p_all "$cmd2"; return 0
  fi

  # Bare fleet-wide command with no target → apply to all (friendly default), so
  # `sysible_ctl start` == `sysible_ctl start all`, and likewise up/stop/restart/status.
  # (Bare `up` with nothing built runs the SLOP whole-stack installer — see p_all.)
  case "$a1" in
    status|start|stop|restart|up|build) p_all "$(_canon_cmd "$a1")"; return 0 ;;
  esac

  _err "unknown or ambiguous: '$a1${a2:+ $a2}'"
  echo >&2
  usage >&2
  exit 1
}

main "$@"
