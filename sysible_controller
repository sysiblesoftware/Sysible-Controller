#!/bin/bash
# Sysible Controller control CLI - installed to /usr/local/bin/sysible_controller
# by install_sysible.sh. The backend API runs as a real systemd service (sysible-backend) so
# it survives reboots and isn't tied to a terminal session or a
# script's own lifetime. This wraps `systemctl` for that service and
# the web console service.
#
# Usage: sysible_controller {start|stop|restart|update|status|logs|webgui|reset-admin|self-enroll|disenroll|destroy}

BASE="/opt/sysible"
VENV="$BASE/venv"
RUN_DIR="$BASE/run"
PORTAL_PID_FILE="$RUN_DIR/portal.pid"
SERVICE="sysible-backend"
PORT=9000
CERT_FILE="$BASE/certs/server.crt"

# Best-effort fallback only - install_sysible.sh already creates this run
# directory; this mkdir mostly matters for an install predating that.
mkdir -p "$RUN_DIR" 2>/dev/null

_require_root() {
  if [[ $EUID -ne 0 ]]; then
    echo "Run as root: sudo sysible_controller $1"
    exit 1
  fi
}

# =========================================================
# WEB CONSOLE (browser-based, headless-friendly GUI)
# Managed by backend/webgui_manager.py - which handles building the front
# end, the persistent cookie secret, TLS (reusing the controller's own
# cert), health-gated startup, and stop. We drive it from the same venv the
# backend uses so it can import the controller's client.* modules. This is
# what gives a headless controller a GUI: a browser-based console.
# Best-effort: a web-console hiccup never blocks the controller itself.
# Set SYSIBLE_WEBGUI=0 to opt out of auto-start.
# =========================================================
# The web console runs as its own systemd service (sysible-webgui), separate
# from the backend, so it can be started/stopped on its own.
WEBGUI_SERVICE="sysible-webgui"

_start_webgui() {
  if ! systemctl list-unit-files "${WEBGUI_SERVICE}.service" >/dev/null 2>&1 \
     || ! systemctl cat "${WEBGUI_SERVICE}.service" >/dev/null 2>&1; then
    echo "Web console service not installed. Run 'sudo $BASE/install_sysible.sh' first."
    return 1
  fi
  echo "Starting web console (${WEBGUI_SERVICE})..."
  systemctl enable --now "${WEBGUI_SERVICE}.service" 2>/dev/null
  local ip; ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  echo "  Web console: https://${ip:-<this-host>}:8800/"
}

_stop_webgui() {
  systemctl disable --now "${WEBGUI_SERVICE}.service" >/dev/null 2>&1 || true
}

# =========================================================
# Readiness wait + "is this actually current code" self-check -
# needed since systemd reporting the unit as "active" only means the
# process launched, not that uvicorn finished binding and serving
# current routes yet.
# =========================================================
_wait_for_backend() {
  echo "Waiting for API..."

  until curl -s --cacert "$CERT_FILE" "https://127.0.0.1:$PORT/" >/dev/null 2>&1; do
    if ! systemctl is-active --quiet "$SERVICE"; then
      echo "ERROR: $SERVICE failed to start. Check: journalctl -u $SERVICE -n 50"
      exit 1
    fi
    sleep 1
  done

  if ! curl -s --cacert "$CERT_FILE" "https://127.0.0.1:$PORT/openapi.json" | grep -q '"/agents/heartbeat"'; then
    echo "ERROR: API is responding but doesn't expose the expected routes (or the TLS cert doesn't match) - likely stale code or a bad cert."
    echo "Run 'sudo lsof -i :$PORT' to see what's actually serving this port."
    exit 1
  fi

  echo "API ready (current code confirmed, HTTPS verified)"
}

cmd_start() {
  _require_root start

  if [[ ! -f "$CERT_FILE" ]]; then
    echo "ERROR: TLS certificate not found at $CERT_FILE"
    echo "Run 'sudo $BASE/install_sysible.sh' first."
    exit 1
  fi

  echo "Starting $SERVICE..."
  systemctl start "$SERVICE"
  _wait_for_backend

  echo ""
  echo "Controller backend is running. The web console is a separate service,"
  echo "started on its own:"
  echo "   Web console : sudo sysible_controller webgui start"
  echo "'sysible_controller status' to check, 'sysible_controller logs' to tail the backend."

  # Auto-enroll the controller itself as a managed host on first start, so it
  # appears in the fleet like any other box (privileged agent). Idempotent and
  # strictly best-effort — a failure here must NEVER fail the controller start.
  # Opt out with SYSIBLE_NO_SELF_ENROLL=1.
  if [[ "${SYSIBLE_NO_SELF_ENROLL:-0}" != "1" ]]; then
    cmd_self_enroll || echo "(controller self-enroll skipped — run 'sudo sysible_controller self-enroll' to add it to the fleet later)"
  fi
}

# Enroll THIS controller as a managed host (privileged root agent), so it shows
# up in the fleet and you can patch/script/terminal into it like any other box.
# Idempotent (skips if the local agent is already installed) and safe to re-run.
cmd_self_enroll() {
  _require_root self-enroll
  local agent_dir="/opt/sysible-agent"
  local agent_on_disk=0
  if systemctl is-enabled sysible-agent >/dev/null 2>&1 || [[ -f "$agent_dir/agent.py" ]]; then
    agent_on_disk=1
  fi

  if [[ ! -f "$CERT_FILE" ]]; then
    [[ "$agent_on_disk" == "1" ]] && { echo "Controller agent already present at $agent_dir."; return 0; }
    echo "ERROR: TLS certificate not found at $CERT_FILE - run the installer first." >&2
    return 1
  fi
  local key
  key="$(cat "$BASE/api_key.txt" 2>/dev/null)"
  if [[ -z "$key" ]]; then
    [[ "$agent_on_disk" == "1" ]] && { echo "Controller agent already present at $agent_dir."; return 0; }
    echo "ERROR: admin API key not found at $BASE/api_key.txt." >&2
    return 1
  fi

  # Is the controller reachable on loopback right now? (It mints the single-use token.)
  local controller_up=0
  curl -s --cacert "$CERT_FILE" "https://127.0.0.1:$PORT/" >/dev/null 2>&1 && controller_up=1

  # Decide whether we actually need to (re)enroll. The old gate trusted on-disk
  # presence ALONE, so after a DB reset or `disenroll --self` — both of which can
  # leave $agent_dir on disk while the controller no longer holds a host row — this
  # wrongly reported "already enrolled" and the controller never reappeared in the
  # fleet. Now we ask the controller's OWN API whether this host is a live member
  # before skipping; if it isn't, we re-enroll even though the files exist on disk.
  if [[ "$agent_on_disk" == "1" ]]; then
    if [[ "$controller_up" != "1" ]]; then
      # Can't verify membership while the controller is down; don't churn the agent
      # on every `start`. It gets re-checked the next time the controller is up.
      echo "Controller agent already present at $agent_dir."
      return 0
    fi
    local state_file="${SYSIBLE_AGENT_STATE:-/var/lib/sysible/agent_state.json}"
    local sid=""
    if [[ -f "$state_file" ]]; then
      sid="$(python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("host_id",""))
except Exception:
    pass' "$state_file" 2>/dev/null)"
    fi
    if [[ -n "$sid" ]] && curl -fsS --cacert "$CERT_FILE" -H "X-API-Key: $key" \
         "https://127.0.0.1:$PORT/agents" 2>/dev/null | grep -qF -- "\"$sid\""; then
      echo "Controller is already enrolled as a managed host and present in the fleet."
      return 0
    fi
    echo "Controller agent is on disk but is NOT a live member of the fleet (DB reset"
    echo "or self-disenroll) - re-enrolling so it reappears in the console ..."
    systemctl disable --now sysible-agent.service >/dev/null 2>&1 || true
    rm -f "$state_file" 2>/dev/null || true
  fi

  # From here we (re)enroll, which needs the controller up.
  if [[ "$controller_up" != "1" ]]; then
    echo "Controller isn't responding on https://127.0.0.1:$PORT - start it first, then re-run: sudo sysible_controller self-enroll" >&2
    return 1
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    echo "ERROR: 'unzip' is required to unpack the agent bundle - install it, then re-run: sudo sysible_controller self-enroll" >&2
    return 1
  fi

  echo "Enrolling this controller as a managed host (privileged agent) ..."
  local tmp; tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN

  # Loopback bundle: the controller's own agent connects over 127.0.0.1, which
  # the self-signed cert always covers and which works even before any LAN
  # hostname/IP is configured.
  if ! curl -fsS --cacert "$CERT_FILE" -H "X-API-Key: $key" \
        "https://127.0.0.1:$PORT/self-enroll-bundle" -o "$tmp/bundle.zip"; then
    echo "ERROR: could not download the self-enroll bundle from the controller (is the host cap reached?)." >&2
    return 1
  fi
  if ! ( cd "$tmp" && unzip -qo bundle.zip ); then
    echo "ERROR: could not unpack the agent bundle." >&2
    return 1
  fi
  if [[ ! -f "$tmp/run_agent.sh" ]]; then
    echo "ERROR: agent bundle is missing run_agent.sh." >&2
    return 1
  fi
  chmod +x "$tmp/run_agent.sh"
  # run_agent.sh installs to /opt/sysible-agent as a privileged (root) agent by
  # default, sets up the systemd unit, starts it, and the agent enrolls on its
  # first poll a moment later.
  if ! ( cd "$tmp" && ./run_agent.sh ); then
    echo "ERROR: agent install failed." >&2
    return 1
  fi
  echo "Controller self-enrolled — it will appear in the fleet shortly (Host Enrollment)."
}

# Force-remove an enrolled host from THIS controller — the operator escape hatch for
# when the normal disenroll can't complete: a stale pinned TLS cert (the agent can't
# verify the controller), an offline/zombie agent, or a graceful disenroll that keeps
# re-enrolling. Talks to the controller's OWN API over loopback using the LIVE serving
# cert, so it works even when every agent's pinned cert has drifted. Defaults to a FORCE
# removal (purges the host's enrollment token so a still-running agent can't re-enroll);
# pass --keep-token for a plain removal. Falls back to a direct database delete if the
# controller API is unreachable.
#
#   sudo sysible_controller disenroll --self             # this controller's own host record
#   sudo sysible_controller disenroll --name rocky-02
#   sudo sysible_controller disenroll --ip 192.168.8.42
#   sudo sysible_controller disenroll <host_id>
#   sudo sysible_controller disenroll --self --dry-run   # preview only
_disenroll_usage() {
  cat >&2 <<'EOF'
Usage: sysible_controller disenroll (--self | --name NAME | --ip IP | --host-id ID | <host_id>) [options]

Force-remove an enrolled host from this controller. Talks to the controller over
loopback with the live TLS cert, so it works even when an agent's pinned cert has
drifted. Defaults to a FORCE removal (purges the host's enrollment token so a
still-running agent can't re-enroll).

  --self          This controller's own managed-host record
  --name NAME     Match by hostname
  --ip IP         Match by IP address
  --host-id ID    Match by exact host_id (also accepted positionally)
  --keep-token    Plain removal — leave the enrollment token valid (host may re-enroll)
  --dry-run       Show what would be removed; change nothing
  -y, --yes       Don't prompt for confirmation
EOF
}

# Filter the /agents roster (JSON on stdin) to host_id<TAB>hostname<TAB>ip lines.
# The program is passed with -c (NOT a heredoc) so the piped roster stays on stdin.
_DISENROLL_FILTER_PY='
import json, sys
mode = sys.argv[1]
value = sys.argv[2] if len(sys.argv) > 2 else ""
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
agents = data.get("agents", []) if isinstance(data, dict) else (data or [])
v = value.strip().lower()
for a in agents:
    if not isinstance(a, dict):
        continue
    hid = str(a.get("host_id") or "")
    hn = str(a.get("hostname") or "")
    ip = str(a.get("ip") or "")
    if mode == "self":
        hit = bool(a.get("is_controller"))
    elif mode == "host_id":
        hit = hid.lower() == v
    elif mode == "name":
        hit = hn.lower() == v
    elif mode == "ip":
        hit = ip == value.strip()
    else:
        hit = False
    if hit:
        print("\t".join([hid, hn, ip]))
'
_disenroll_filter() {
  local pybin="$1" mode="$2" value="$3"
  "$pybin" -c "$_DISENROLL_FILTER_PY" "$mode" "$value"
}

# Last-resort direct database removal (controller API unreachable).
_disenroll_db_fallback() {
  local pybin="$1" mode="$2" value="$3" dry="$4"
  if [[ "$mode" == "self" ]]; then
    echo "ERROR: --self resolves the controller's own record via the API, which is unreachable." >&2
    echo "       Start the controller ('sysible_controller start') and retry, or use --name/--ip/<host_id>." >&2
    return 1
  fi
  local tool="$BASE/tools/unenroll_agent.py"
  [[ -f "$tool" ]] || tool="$(dirname "$0")/tools/unenroll_agent.py"
  if [[ ! -f "$tool" ]]; then
    echo "ERROR: direct-removal helper not found (tools/unenroll_agent.py); cannot fall back." >&2
    return 1
  fi
  local args=()
  case "$mode" in
    name)    args=(--name "$value") ;;
    ip)      args=(--ip "$value") ;;
    host_id) args=("$value") ;;
  esac
  [[ "$dry" == "1" ]] && args+=(--dry-run)
  "$pybin" "$tool" "${args[@]}"
}

cmd_disenroll() {
  _require_root disenroll
  shift  # drop the "disenroll" subcommand

  local selector="" value="" assume_yes=0 dry_run=0 keep_token=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --self)       selector="self" ;;
      --name)       selector="name";    value="$2"; shift ;;
      --name=*)     selector="name";    value="${1#*=}" ;;
      --ip)         selector="ip";      value="$2"; shift ;;
      --ip=*)       selector="ip";      value="${1#*=}" ;;
      --host-id|-i) selector="host_id"; value="$2"; shift ;;
      --host-id=*)  selector="host_id"; value="${1#*=}" ;;
      -y|--yes)     assume_yes=1 ;;
      --dry-run)    dry_run=1 ;;
      --keep-token) keep_token=1 ;;
      -h|--help)    _disenroll_usage; return 0 ;;
      -*)           echo "Unknown option: $1" >&2; _disenroll_usage; return 1 ;;
      *)            selector="host_id"; value="$1" ;;
    esac
    shift
  done

  if [[ -z "$selector" ]]; then _disenroll_usage; return 1; fi
  if [[ "$selector" != "self" && -z "$value" ]]; then
    echo "ERROR: --$selector needs a value." >&2; return 1
  fi

  local PYBIN="python3"
  [[ -x "$VENV/bin/python" ]] && PYBIN="$VENV/bin/python"

  local key; key="$(cat "$BASE/api_key.txt" 2>/dev/null)"
  local base="https://127.0.0.1:$PORT"

  # Pull the roster over loopback with the LIVE serving cert (immune to any agent
  # pinned-cert drift). If the controller API can't be reached, fall back to the DB.
  local roster rc
  roster="$(curl -fsS --cacert "$CERT_FILE" -H "X-API-Key: $key" "$base/agents" 2>/dev/null)"; rc=$?
  if [[ $rc -ne 0 || -z "$roster" ]]; then
    echo "Controller API not reachable on $base — falling back to a direct database removal."
    _disenroll_db_fallback "$PYBIN" "$selector" "$value" "$dry_run"
    return $?
  fi

  local matches
  matches="$(printf '%s' "$roster" | _disenroll_filter "$PYBIN" "$selector" "$value")"
  if [[ -z "$matches" ]]; then
    echo "No enrolled host matches --$selector${value:+ $value}."
    echo "Tip: list enrolled hosts with"
    echo "  curl -s --cacert $CERT_FILE -H \"X-API-Key: \$(cat $BASE/api_key.txt)\" $base/agents | ${PYBIN} -m json.tool"
    return 1
  fi

  local n; n="$(printf '%s\n' "$matches" | grep -c .)"
  if [[ "$n" -gt 1 ]]; then
    echo "Multiple hosts match — narrow it down with --host-id <id>:" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{printf "  %-38s %-24s %s\n", $1, $2, $3}' >&2
    return 2
  fi

  local host_id hostname ip
  host_id="$(printf '%s' "$matches" | cut -f1)"
  hostname="$(printf '%s' "$matches" | cut -f2)"
  ip="$(printf '%s' "$matches" | cut -f3)"

  local pt=1; [[ "$keep_token" == "1" ]] && pt=0
  local mode_desc="Force-remove (purges the enrollment token so it can't re-enroll)"
  [[ "$pt" == "0" ]] && mode_desc="Remove (keeps the enrollment token — the host may re-enroll)"

  echo "Target host: ${hostname:-?}${ip:+  ($ip)}  [$host_id]"
  echo "Action:      $mode_desc"
  if [[ "$dry_run" == "1" ]]; then echo "(dry run — nothing changed)"; return 0; fi

  if [[ "$assume_yes" != "1" ]]; then
    read -r -p "Disenroll this host from the controller? [y/N] " ans
    case "$ans" in y|Y|yes|YES) ;; *) echo "Aborted."; return 1 ;; esac
  fi

  local out drc
  out="$(curl -fsS -X DELETE --cacert "$CERT_FILE" -H "X-API-Key: $key" \
        "$base/agents/$host_id?purge_token=$pt" 2>&1)"; drc=$?
  if [[ $drc -ne 0 ]]; then
    echo "ERROR: the controller refused the removal: $out" >&2
    echo "Trying a direct database removal instead..."
    _disenroll_db_fallback "$PYBIN" "host_id" "$host_id" 0
    return $?
  fi
  echo "Removed '${hostname:-$host_id}' from the controller."

  # If we just removed THIS controller's own agent record, stop the local agent so
  # it doesn't keep hammering the controller (with the token purged it can't
  # re-enroll anyway). Full local file cleanup is the bundle's disenroll_agent.sh.
  if [[ "$selector" == "self" ]]; then
    if systemctl list-unit-files sysible-agent.service >/dev/null 2>&1; then
      echo "Stopping the local agent (sysible-agent)…"
      systemctl disable --now sysible-agent.service >/dev/null 2>&1 || true
      echo "Local agent stopped. To also remove its files, run the bundle's disenroll_agent.sh."
    fi
  fi
}

cmd_stop() {
  _require_root stop

  _stop_webgui

  echo "Stopping $SERVICE..."
  systemctl stop "$SERVICE" 2>/dev/null

  # Safety net for a portal subprocess left outside the unit's cgroup
  # (or anything else squatting on $PORT) - a backend process doesn't
  # always clean up everything it spawned on its own.
  if [[ -f "$PORTAL_PID_FILE" ]]; then
    pid="$(cat "$PORTAL_PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
      echo "Stopping portal (PID $pid)..."
      kill "$pid" 2>/dev/null
    fi
    rm -f "$PORTAL_PID_FILE"
  fi

  if command -v lsof >/dev/null 2>&1; then
    STRAY_PIDS="$(lsof -ti tcp:"$PORT" 2>/dev/null)"
    if [[ -n "$STRAY_PIDS" ]]; then
      echo "Port $PORT still held by PID(s) $STRAY_PIDS (untracked) - killing..."
      kill $STRAY_PIDS 2>/dev/null
      sleep 1
      STRAY_PIDS="$(lsof -ti tcp:"$PORT" 2>/dev/null)"
      [[ -n "$STRAY_PIDS" ]] && kill -9 $STRAY_PIDS 2>/dev/null
    fi
  fi

  echo "Done."
}

cmd_restart() {
  _require_root restart

  # Remember whether the web console was up, so a full restart brings it back
  # instead of silently leaving it down (cmd_stop stops it as part of cleanup).
  local webgui_was_up=0
  systemctl is-active --quiet "${WEBGUI_SERVICE}.service" && webgui_was_up=1

  cmd_stop
  cmd_start

  if [[ "$webgui_was_up" == "1" ]]; then
    echo ""
    echo "Restarting the web console (it was running before)..."
    _start_webgui
  fi
}

# =========================================================
# UPDATE (pull latest code + redeploy)
# The service always runs out of $BASE, which is a *copy* the installer
# rsync'd from the git checkout - so a plain `git pull` in the checkout
# never changes what's running. This command does the whole redeploy in
# one shot: pull the recorded checkout, re-sync it into $BASE (preserving
# the venv/DB/key/certs/run dir exactly like the installer), and restart.
# The built front end (webgui/frontend/dist) isn't tracked in git, so the
# --delete sync removes the stale bundle and start_webgui.sh rebuilds it
# when the web console comes back up.
# =========================================================
# Record the outcome of a self-update so the API (and thus the web console's
# "Update controller" button) can report the TRUTH instead of guessing from
# whether the console bounced. Written to $RUN_DIR (excluded from the rsync
# --delete, so it survives the redeploy). Read by GET /controller/update-status.
_write_update_status() {
  # $1=status (running|success|failed)   $2=message   $3=version (optional)
  local f="$RUN_DIR/last_update.json"
  mkdir -p "$RUN_DIR" 2>/dev/null || true
  local msg="${2//\\/\\\\}"; msg="${msg//\"/\\\"}"; msg="${msg//$'\n'/ }"
  printf '{"status":"%s","message":"%s","version":"%s","ts":%s}\n' \
    "$1" "$msg" "${3:-}" "$(date +%s)" > "$f" 2>/dev/null || true
  chmod 644 "$f" 2>/dev/null || true
}

cmd_update() {
  _require_root update
  # Persist the full update output to a file (in addition to the journal) so the
  # web console can stream it and it stays downloadable afterward.
  # Truncate for this run, then tee everything below to it. run/ is excluded from
  # the rsync --delete, so the log survives the redeploy.
  mkdir -p "$RUN_DIR" 2>/dev/null || true
  : > "$RUN_DIR/last_update.log" 2>/dev/null || true
  exec > >(tee -a "$RUN_DIR/last_update.log") 2>&1
  echo "=== Sysible Controller self-update — $(date -Is 2>/dev/null || date) ==="
  _write_update_status running "Update started" ""

  local SRC=""
  [[ -f "$BASE/.install_src" ]] && SRC="$(cat "$BASE/.install_src" 2>/dev/null)"
  if [[ -z "$SRC" || ! -d "$SRC" ]]; then
    echo "ERROR: can't find the source checkout to update from"
    echo "       (its path is recorded in $BASE/.install_src at install time)."
    echo "Re-run the installer from your git checkout instead:"
    echo "   cd <your-checkout> && sudo git pull && sudo ./install_sysible.sh"
    _write_update_status failed "Can't find the source checkout to update from ($BASE/.install_src missing or invalid)."
    exit 1
  fi

  echo "Updating Sysible Controller from $SRC ..."

  # 1) Refresh the checkout (best-effort - skip cleanly if it isn't a git repo).
  #    -c safe.directory="$SRC": the updater runs as root (systemd-run) but the
  #    checkout is usually owned by the install user, so modern git refuses to
  #    operate ("detected dubious ownership") and the pull aborts. Trust this one
  #    path inline (no global git config change) so the update actually applies.
  if [[ -d "$SRC/.git" ]] && command -v git >/dev/null 2>&1; then
    echo "Pulling latest code (git) ..."
    _git() { git -C "$SRC" -c safe.directory="$SRC" "$@"; }
    _pull_out="$(_git pull --ff-only 2>&1)"; _pull_rc=$?
    printf '%s\n' "$_pull_out"
    if [[ $_pull_rc -ne 0 ]]; then
      # An untracked-file collision ("untracked working tree files would be overwritten
      # by merge") is NOT a ref-store problem — the checkout has untracked files shadowing
      # files the update adds, and a ref repair won't help. Give the exact, safe remedy
      # and stop, rather than falling through to a misleading "ref-store repair" attempt.
      # We deliberately do NOT auto-delete untracked files (possible data loss) — the
      # operator decides. A deploy checkout's untracked files are normally just cruft, and
      # git clean -fd leaves the git-ignored built dist/ and node_modules/ untouched.
      if printf '%s' "$_pull_out" | grep -q 'untracked working tree files would be overwritten'; then
        echo "ERROR: update blocked — this checkout has UNTRACKED files that collide with the incoming update."
        echo "       A ref-store repair can't fix this. On the host, clear the untracked cruft, then retry:"
        echo "         cd $SRC && sudo git -c safe.directory=\"\$PWD\" clean -fd && sudo git -c safe.directory=\"\$PWD\" pull --ff-only"
        echo "       (clean -fd removes only untracked files; the ignored dist/ and node_modules/ are preserved.)"
        echo "       Reversible alternative (keeps a recoverable copy in a stash):"
        echo "         cd $SRC && sudo git -c safe.directory=\"\$PWD\" stash push --include-untracked -m pre-update && sudo git -c safe.directory=\"\$PWD\" pull --ff-only"
        echo "       Then re-run the update."
        _write_update_status failed "Update blocked: untracked files in $SRC collide with the incoming update. On the host run: cd $SRC && sudo git -c safe.directory=\$PWD clean -fd (removes untracked cruft; keeps ignored dist/ and node_modules/), then retry update. Reversible alt: stash push --include-untracked."
        exit 1
      fi
      # TRACKED local modifications ("Your local changes to the following files
      # would be overwritten by merge") — the checkout has edits to files the update
      # also changes. A ref-store repair can't fix this either. On a deploy box these
      # are often site edits (values.yaml, Dockerfile) tangled with accidental ones,
      # so we NEVER auto-discard (data loss) — give the reversible stash remedy and
      # the inspect-then-discard alternative, and stop.
      if printf '%s' "$_pull_out" | grep -q 'Your local changes to the following files would be overwritten'; then
        echo "ERROR: update blocked — this checkout has LOCAL MODIFICATIONS to tracked files that the update also changes."
        echo "       A ref-store repair can't fix this. First see what changed:"
        echo "         cd $SRC && sudo git -c safe.directory=\"\$PWD\" status && sudo git -c safe.directory=\"\$PWD\" diff --stat"
        echo "       Reversible — stash your edits (recoverable), then re-run the update:"
        echo "         cd $SRC && sudo git -c safe.directory=\"\$PWD\" stash push -m pre-update && sudo sysible_controller update"
        echo "         # reapply afterwards if you still need them: sudo git -c safe.directory=\"\$PWD\" stash pop"
        echo "       Or discard the local edits entirely (destructive — ONLY if they're unwanted):"
        echo "         cd $SRC && sudo git -c safe.directory=\"\$PWD\" checkout -- <file>...   # or: reset --hard @{u}"
        _write_update_status failed "Update blocked: tracked files in $SRC are locally modified and collide with the incoming update. On the host: cd $SRC && sudo git -c safe.directory=\$PWD stash push -m pre-update (reversible), then retry update; reapply with 'stash pop'. Or discard with 'git checkout -- <file>' / 'git reset --hard @{u}' if unwanted."
        exit 1
      fi
      # A common, non-fatal failure is a corrupted ref store — e.g.
      #   "fetching ref refs/remotes/origin/main failed: reference already exists"
      # — a loose remote-tracking ref colliding with packed-refs, usually left by
      # a previously interrupted update. Remote-tracking refs are just a cache of
      # origin, so repairing/rebuilding them is SAFE (it touches no local commits
      # or working-tree changes). Try that once, then retry the pull.
      echo "git pull failed — attempting an automatic ref-store repair (safe: only rebuilds the origin/* cache) ..."
      # Remove stale git lock files first — a git process killed/crashed mid-fetch
      # (e.g. a timed-out update-check) leaves *.lock files that block every later
      # ref update ("cannot lock ref ... .lock: File exists", surfacing as
      # "reference already exists"). These are transient locks, not data.
      find "$SRC/.git" -name '*.lock' -type f -delete 2>/dev/null || true
      _git pack-refs --all --prune 2>&1 || true
      _git remote prune origin 2>&1 || true
      _git for-each-ref --format='%(refname)' refs/remotes/origin 2>/dev/null \
        | while read -r _r; do _git update-ref -d "$_r" 2>/dev/null || true; done
      _git fetch --prune origin 2>&1 || true
      if ! _git pull --ff-only 2>&1; then
        echo "ERROR: 'git pull' still failed in $SRC after a ref-store repair - resolve it there, then re-run update."
        _write_update_status failed "'git pull --ff-only' failed in $SRC even after an automatic ref-store repair (likely local changes or a diverged branch). On the host: cd $SRC && sudo git -c safe.directory=\$PWD status — commit/stash/discard local changes or reset to origin, then retry."
        exit 1
      fi
      echo "Ref-store repair succeeded; update continues."
    fi
  else
    echo "NOTE: $SRC is not a git checkout - redeploying whatever code is there now."
  fi

  # 2) Sync into $BASE. Excludes MUST match install_sysible.sh so the live
  #    venv, database, API key, host records, SSH keys, certs, and run dir are
  #    never clobbered. --delete clears stale files (incl. the old dist/).
  if [[ "$SRC" != "$BASE" ]]; then
    if ! command -v rsync >/dev/null 2>&1; then
      echo "ERROR: rsync not found - run 'sudo $SRC/install_sysible.sh' instead."
      _write_update_status failed "rsync not found on the host - run 'sudo $SRC/install_sysible.sh' instead."
      exit 1
    fi
    echo "Syncing code into $BASE ..."
    rsync -a --delete \
      --exclude venv \
      --exclude run \
      --exclude logs \
      --exclude '*.db' \
      --exclude api_key.txt \
      --exclude hosts.json \
      --exclude remote_keys \
      --exclude agent_state.json \
      --exclude certs \
      --exclude '__pycache__' \
      --exclude '*.pyc' \
      --exclude '.git' \
      --exclude node_modules \
      "$SRC"/ "$BASE"/
    # rsync --delete removes BASE-only files not present in the checkout,
    # including .install_src itself - rewrite it so the NEXT update still works
    # (install_sysible.sh does the same after its own sync).
    echo "$SRC" > "$BASE/.install_src" 2>/dev/null || true
  fi

  # Ensure the deployed shell scripts are executable. rsync -a preserves the
  # SOURCE's mode, so if a script isn't marked +x in the repo the service's
  # ExecStart can't run it (systemd 203/EXEC -> crash loop). install_sysible.sh
  # chmods these for the same reason; do it here too as a backstop.
  chmod +x "$BASE/start_webgui.sh" "$BASE/install_sysible.sh" \
           "$BASE/sysible_controller" 2>/dev/null || true

  # Refresh the installed CLI wrapper too - rsync only updated $BASE's copy,
  # not the /usr/local/bin one we're running from. Atomic mv (not cp-in-place)
  # so replacing the very script in flight can't corrupt this execution: the
  # old inode stays open for the rest of THIS run; the new code applies next time.
  local self="/usr/local/bin/sysible_controller"
  if [[ -f "$BASE/sysible_controller" && -e "$self" ]]; then
    if cp -f "$BASE/sysible_controller" "$self.new" 2>/dev/null; then
      chmod 755 "$self.new" 2>/dev/null
      mv -f "$self.new" "$self" 2>/dev/null \
        && echo "Refreshed $self (new CLI applies on next run)." \
        || { rm -f "$self.new" 2>/dev/null; echo "NOTE: could not replace $self."; }
    fi
  fi

  # 3) Refresh Python deps in case requirements changed (best-effort).
  if [[ -x "$VENV/bin/pip" ]]; then
    echo "Updating Python dependencies ..."
    "$VENV/bin/pip" install -q -r "$BASE/requirements.txt" \
      || echo "NOTE: backend dependency refresh hit an issue - check $BASE/requirements.txt."
    if [[ -f "$BASE/webgui/requirements.txt" ]]; then
      "$VENV/bin/pip" install -q -r "$BASE/webgui/requirements.txt" \
        || echo "NOTE: web-console dependency refresh hit an issue."
    fi
  fi

  # 3b) Rebuild the web console front end DIRECTLY (outside systemd) before the
  #     restart. The rsync --delete above cleared the old dist/ (and the
  #     untracked node_modules), so leaving the rebuild to start_webgui.sh inside
  #     the service's ExecStart can be slow enough to trip the unit's start
  #     timeout and leave the web console down - which is why a plain `update`
  #     sometimes needed a follow-up install. install_sysible.sh builds it
  #     directly for exactly this reason; mirror that here. Best-effort.
  if [[ -d "$BASE/webgui/frontend" ]] && command -v npm >/dev/null 2>&1; then
    echo "Rebuilding the web console front end ..."
    ( cd "$BASE/webgui/frontend" && npm install --no-audit --no-fund && npm run build ) \
      || echo "NOTE: web console front-end rebuild hit an issue; it will retry on web start."
  fi

  # 4) Restart. cmd_restart brings the backend back and, if the web console was
  #    running, restarts it too (front end already rebuilt above, so it's fast).
  echo "Restarting services ..."
  cmd_restart

  # Self-heal: if the web console is enabled but not running (e.g. a prior
  # botched update left it down, so cmd_restart's "was it running" check skipped
  # it), bring it back. The front end is already built above, so this is fast.
  if systemctl is-enabled --quiet "${WEBGUI_SERVICE}.service" 2>/dev/null \
     && ! systemctl is-active --quiet "${WEBGUI_SERVICE}.service" 2>/dev/null; then
    echo "Ensuring the web console is up ..."
    _start_webgui
  fi

  # Record success with the version we landed on, so the API can confirm the
  # code actually changed (and to what) rather than the UI guessing.
  local _newver=""
  if [[ -d "$SRC/.git" ]] && command -v git >/dev/null 2>&1; then
    _newver="$(git -C "$SRC" -c safe.directory="$SRC" rev-parse --short HEAD 2>/dev/null)"
  fi
  _write_update_status success "Update complete." "$_newver"

  echo ""
  echo "Update complete."
  echo "Then hard-refresh your browser (Ctrl/Cmd+Shift+R) to drop the old bundle."
  echo ""
  echo "NOTE: managed hosts run their own copy of the agent - to pick up agent"
  echo "      changes, redeploy the agent to each host (re-run its installer)."
}

cmd_status() {
  systemctl status "$SERVICE" --no-pager
  echo ""
  "$VENV/bin/python" - "$BASE" 2>/dev/null <<'PY' || true
import sys
sys.path.insert(0, sys.argv[1])
from backend import webgui_manager as m
s = m.status()
if s.get("running"):
    print(f"Web console: running ({s.get('scheme')} port {s.get('port')}, PID {s.get('pid')})")
else:
    print("Web console: not running")
PY
}

cmd_logs() {
  journalctl -u "$SERVICE" -f
}

cmd_webgui() {
  # Manual control of the browser-based console, independent of the
  # controller's own start/stop. Root: it reads the TLS key and writes its
  # pid/secret under $RUN_DIR, same as the backend.
  case "$2" in
    start)
      _require_root "webgui start"
      _start_webgui
      ;;
    stop)
      _require_root "webgui stop"
      _stop_webgui
      echo "Web console stopped."
      ;;
    restart)
      _require_root "webgui restart"
      _stop_webgui
      _start_webgui
      ;;
    status|"")
      if systemctl is-active --quiet "${WEBGUI_SERVICE}.service"; then
        ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
        echo "Web console: running (${WEBGUI_SERVICE}) -> https://${ip:-<this-host>}:8800/"
      else
        echo "Web console: not running. Start it with 'sysible_controller webgui start'."
      fi
      systemctl status "${WEBGUI_SERVICE}.service" --no-pager 2>/dev/null | head -5 || true
      ;;
    logs)
      journalctl -u "${WEBGUI_SERVICE}.service" -n 50 --no-pager
      ;;
    *)
      echo "Usage: sysible_controller webgui {start|stop|restart|status|logs}"
      exit 1
      ;;
  esac
}

cmd_reset_admin() {
  # Set (or create) a web-console administrator's password. Use when the
  # default install-time admin was skipped (admins already existed) or the
  # password was lost. Username defaults to 'admin'; password is generated
  # unless given. Prints the credentials once.
  _require_root "reset-admin"
  local user="${2:-admin}"
  local pass="$3"
  local out
  out="$("$VENV/bin/python" - "$BASE" "$user" "$pass" <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
from backend.db import add_administrator, update_administrator_password, list_administrators, get_admin_password_policy
from backend import portal_auth
from backend.policy import generate_compliant_password
user = sys.argv[2] or "admin"
pw = sys.argv[3] or generate_compliant_password(get_admin_password_policy())
salt, h = portal_auth.hash_password(pw)
existing = {a.get("username") for a in list_administrators()}
if user in existing:
    update_administrator_password(user, h, salt, must_change_password=1)
    print(f"reset\t{user}\t{pw}")
else:
    add_administrator(user, h, salt, must_change_password=1, created_by="reset-admin", role="superuser")
    print(f"created\t{user}\t{pw}")
PY
)"
  if [[ -z "$out" ]]; then
    echo "ERROR: could not reset the admin (is the controller installed at $BASE?)."
    exit 1
  fi
  local action u p
  action="$(echo "$out" | cut -f1)"; u="$(echo "$out" | cut -f2)"; p="$(echo "$out" | cut -f3)"
  local R='\033[1;91m' Z='\033[0m'   # bold bright red / reset
  echo "==================================================================="
  echo -e "${R} Web console admin ${action}:${Z}"
  echo -e "${R}     username:  $u${Z}"
  echo -e "${R}     password:  $p${Z}"
  echo -e "${R} Log in at the web console, then change it (Settings -> My Account).${Z}"
  echo "==================================================================="
}

cmd_destroy() {
  _require_root destroy

  # --purge: also remove the leftover DB backup(s) in /tmp and the source
  # checkout the installer was run from (recorded at install time). Captured
  # here, before $BASE is deleted below.
  local PURGE=0
  [[ "$2" == "--purge" ]] && PURGE=1
  local SRC=""
  [[ -f "$BASE/.install_src" ]] && SRC="$(cat "$BASE/.install_src" 2>/dev/null)"

  echo "==================================================================="
  echo " THIS WILL PERMANENTLY REMOVE SYSIBLE FROM THIS MACHINE:"
  echo "   - stop and disable the $SERVICE and ${WEBGUI_SERVICE} services"
  echo "   - delete $BASE (database, TLS certificate, admin API key -"
  echo "     everything)"
  echo "   - remove this 'sysible_controller' command"
  if [[ "$PURGE" == "1" ]]; then
    echo "   - PURGE: also delete /tmp DB backups and the source checkout"
    [[ -n "$SRC" ]] && echo "            ($SRC)"
  fi
  echo "   - remove THIS machine's own Sysible agent (the controller self-enrolls"
  echo "     itself; that local agent is torn down so it doesn't crash-loop)"
  echo ""
  echo " OTHER enrolled hosts' agents are NOT touched by this - their own"
  echo " sysible-agent systemd services keep running and will just start"
  echo " failing to reach this controller. Disenroll hosts first (or run"
  echo " disenroll_agent.sh on each one) if you want them cleaned up too."
  echo "==================================================================="
  echo ""

  read -rp "Type 'destroy' to confirm: " confirm
  if [[ "$confirm" != "destroy" ]]; then
    echo "Aborted - nothing was changed."
    exit 1
  fi

  echo "Stopping everything..."
  cmd_stop

  echo "Disabling and removing $SERVICE..."
  systemctl disable --now "$SERVICE" 2>/dev/null
  systemctl disable --now "${WEBGUI_SERVICE}.service" 2>/dev/null
  rm -f "/etc/systemd/system/$SERVICE.service" "/etc/systemd/system/${WEBGUI_SERVICE}.service"
  systemctl daemon-reload

  # Remove THIS machine's own self-enrolled agent (the controller enrolls itself as a
  # managed host at /opt/sysible-agent). Without this it keeps crash-looping under
  # systemd Restart=always trying to reach the now-deleted controller. Only the LOCAL
  # agent is removed; other hosts' agents are untouched.
  AGENT_DIR="/opt/sysible-agent"
  if systemctl list-unit-files 2>/dev/null | grep -q '^sysible-agent\.service' || [[ -e "$AGENT_DIR" ]]; then
    echo "Removing this machine's Sysible agent (sysible-agent)..."
    systemctl disable --now sysible-agent.service 2>/dev/null
    rm -f /etc/systemd/system/sysible-agent.service
    systemctl daemon-reload
    rm -rf "$AGENT_DIR"
  fi

  DB_FILE="$BASE/backend/sysible.db"
  if [[ -f "$DB_FILE" && "$PURGE" != "1" ]]; then
    BACKUP="/tmp/sysible-backup-$(date +%Y%m%d%H%M%S).db"
    # The DB holds admin password hashes, agent bearer secrets, live admin
    # tokens and encrypted sudo passwords, so the live file is kept at 0600.
    # A plain `cp` applies the current umask (0644 under root) and would leave
    # this copy WORLD-READABLE in shared /tmp. Create it private: pre-touch at
    # 0600 (owner-only before any bytes land), copy, then re-assert 0600.
    if ( umask 077; : > "$BACKUP" ) 2>/dev/null && cp -f "$DB_FILE" "$BACKUP" 2>/dev/null; then
      chmod 600 "$BACKUP" 2>/dev/null
      echo "Database backed up to $BACKUP (contains secrets — kept at 0600 for root only; this copy is left behind on purpose, delete it yourself once you're sure you don't need it)."
    fi
  fi

  echo "Removing $BASE..."
  rm -rf "$BASE"

  if [[ "$PURGE" == "1" ]]; then
    echo "Purging leftover DB backups in /tmp..."
    rm -f /tmp/sysible-backup-*.db
    if [[ -n "$SRC" && -d "$SRC" && "$SRC" != "/" && "$SRC" != "$BASE" && "$SRC" != "$HOME" ]]; then
      echo "Removing source checkout $SRC..."
      rm -rf "$SRC"
    fi
  fi

  echo "Sysible Controller has been removed from this machine."
  echo "Removing this command..."
  rm -f "$0"
}

case "$1" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  update)  cmd_update ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  webgui)  cmd_webgui "$@" ;;
  reset-admin) cmd_reset_admin "$@" ;;
  self-enroll) cmd_self_enroll ;;
  disenroll) cmd_disenroll "$@" ;;
  destroy) cmd_destroy ;;
  *)
    echo "Usage: sysible_controller {start|stop|restart|update|status|logs|webgui|reset-admin|self-enroll|disenroll|destroy}"
    exit 1
    ;;
esac
